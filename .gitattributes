*.sh text eol=lf
# cmd 批处理必须 CRLF:LF-only 的 .cmd 在 goto/label 跳转时会静默失败(cmd.exe 历史行为)
*.cmd text eol=crlf
scripts/*.sh text eol=lf
plugin/manifest.json text eol=lf
plugin/bin/engine text eol=lf
engine/bin/engine text eol=lf
plugin/engine/scripts/*.sh text eol=lf
plugin/engine/scripts/githooks/* text eol=lf
engine/scripts/*.sh text eol=lf
engine/scripts/githooks/* text eol=lf

# v6 review fix: 钉 dist/src 行尾,避免 autocrlf 噪音
ENGINE_FILE_SYSTEM_v5.md text eol=lf
runtime-law.md text eol=lf
rules.json text eol=lf
contract/src/*.md text eol=lf
# D-015: engine-init.md 纳入编译产物,同样钉 lf
plugin/.claude/commands/engine-init.md text eol=lf

# Task 3: 钉齐 manifest 覆盖的剩余文件,消除 autocrlf 漂移
plugin/.claude/commands/*.md text eol=lf
plugin/CLAUDE.md text eol=lf
plugin/AGENTS.md text eol=lf
plugin/engine/*.md text eol=lf
plugin/engine/prompts/*.md text eol=lf
plugin/bin/engine.ps1 text eol=lf
engine/bin/engine.ps1 text eol=lf
plugin/VERSION text eol=lf
plugin/migrations/*.ps1 text eol=lf
plugin/migrations/*.sh text eol=lf
plugin/.claude/settings.json text eol=lf
engine/*.md text eol=lf
engine/prompts/*.md text eol=lf

# Evidence manifests hash their source bytes; keep them LF on every checkout so
# Bash and PowerShell compute the same aggregate fingerprint on Windows.
engine/evidence/** text eol=lf
