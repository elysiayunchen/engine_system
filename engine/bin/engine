#!/usr/bin/env bash
# Engine System user-level CLI shim.

set -e

REPO="${ENGINE_SYSTEM_REPO:-elysiayunchen/engine_system}"
BRANCH="${ENGINE_SYSTEM_BRANCH:-main}"

usage() {
  cat <<'EOF'
Engine System CLI

Usage:
  engine init           Show how to run the init interview with any AI agent
  engine init --print   Print the raw agent-neutral init prompt (pipe/copy it)
  engine context        Load full session context (agent-agnostic, any AI agent)
  engine workstream T-NNN AGENT [--kind=subagent|session] [--print]   Create an isolated worker memory shard (default --kind=subagent)
  engine assume-coordinator [--force]   Force-take coordinator lock + write tombstone (use after crash or to override)
  engine merge-workstream <session-id>  Display worker shard + guide coordinator through merge steps (no auto-write)
  engine disable-multi-session [on|off|status]  Toggle kill switch (skip lock detection, all sessions degrade to single-session)
  engine check-update   Check if a newer Engine System version is available
  engine update         Update tooling, then migrate + doctor (one-shot)
  engine update --check-only   Only check for updates, change nothing
  engine update --no-migrate   Update tooling but skip migration/doctor
  engine migrate        Run contract migration on existing engine files
  engine verify T-NNN   Run behavior verification for a task card
  engine doctor         Run engine health check
  engine load           Install the engine CLI shim into user PATH (~/.local/bin)
  engine unload         Remove the engine CLI shim from user PATH
  engine help           Show this help

`engine init` is the agent-agnostic entry to initialize the engine layer: it
locates engine/prompts/init.md (distributed by the installer) and shows how to
feed it to your AI agent; --print emits the raw prompt for piping/copying.

`engine check-update` compares local engine/VERSION against the remote VERSION.
Exit codes: 0 = up to date | 7 = update available | 8 = network error.

`engine update` downloads the latest installer, runs update mode (does not
overwrite project-specific engine/*.md memory), then runs the contract migrator
so old engine files receive the v6 data-layer structure and managed contract
block, then runs Doctor to verify. Use --check-only to preview, --no-migrate to
skip the migration step.

`engine migrate` applies migration steps under engine/migrations/ that are
newer than the local engine/VERSION, in version order (sort -V), writing the
version back after each step. When nothing is pending it falls back to the
idempotent contract migrator, so it still repairs/re-applies the v6 structure.

`engine load` re-installs engine external side-effects from the current
project: the user-level CLI shim (~/.local/bin) and the git pre-commit hook
(when engine-managed or missing). Use after switching branches, clobbered
shims, or re-linking to a local checkout. Does not run migrate/doctor and
does not touch .claude/settings.json (use the installer or /engine-sync).

`engine unload` removes all engine tooling from the current project plus
external side-effects: engine/bin, engine/scripts, engine/prompts,
engine/migrations, .claude/commands, .claude/skills, runtime-law.md,
engine/VERSION, engine/domains/routing.json, the user PATH shim, the
engine-managed git pre-commit hook, and the engine-managed .claude/settings.json.
User project memory is preserved: engine/{CONTEXT,HANDOFF,ENGINE_MAP,SYSTEM,
AGENT_ADAPTERS,ENGINE_DOCTOR}.md, engine/{tasks,decisions,changes,evidence,
workstreams,domains,checks}/, and root anchors (CLAUDE.md, AGENTS.md).
EOF
}

create_workstream() {
  local root="$1" task="$2" agent="$3"
  shift 3 2>/dev/null || shift "$#"
  # v6.11.0 (D-029/T-036) AC-8: --kind=subagent|session parameter (default subagent, backward compatible)
  # subagent: worker_id = AGENT (hook detects via agent_id signal 1)
  # session: worker_id = AGENT (top-level session degraded, hook detects via .role=worker marker signal 2)
  local kind="subagent" print_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind=*) kind="${1#--kind=}" ;;
      --kind) shift; kind="${1:-}" ;;
      --print) print_flag="1" ;;
    esac
    shift
  done
  task="$(printf '%s' "$task" | tr '[:lower:]' '[:upper:]')"
  case "$task" in T-[0-9][0-9][0-9]) ;; *) echo "Usage: engine workstream T-NNN AGENT [--kind=subagent|session] [--print]" >&2; return 2 ;; esac
  case "$agent" in ''|*[!A-Za-z0-9._-]*) echo "Error: AGENT may contain only A-Z, a-z, 0-9, dot, underscore, or dash." >&2; return 2 ;; esac
  case "$kind" in
    subagent|session) ;;
    *) echo "Error: --kind must be 'subagent' or 'session' (got: $kind)" >&2; return 2 ;;
  esac
  task_file="$root/engine/tasks/$task.md"
  [ -f "$task_file" ] || { echo "Error: task card not found: engine/tasks/$task.md" >&2; return 2; }
  # v6.11.1 (D-029/T-038) AC-5: s-/a- 前缀约定 + sessions/agents 目录隔离
  # subagent → <task>/agents/a-<agent>/ (subagent 由 Claude Code 派生,agent_id 非空)
  # session  → <task>/sessions/s-<agent>/ (顶层会话降级,PreToolUse 双信号第 2 信号)
  # 前缀只加在目录路径上(人类可读视觉提示),.role=worker 标志 key 用 $agent 不加前缀
  # (与 SessionStart hook 算的 <sid>-main key 一致,确保 PreToolUse 检测匹配)
  case "$kind" in
    subagent) dir="$root/engine/workstreams/$task/agents/a-$agent" ;;
    session)  dir="$root/engine/workstreams/$task/sessions/s-$agent" ;;
  esac
  goal="$(grep '^GOAL:' "$task_file" 2>/dev/null | head -1 | sed 's/^GOAL:[[:space:]]*//')"
  if [ -z "$goal" ]; then
    goal="$(awk '
      /^##[[:space:]]+GOAL[[:space:]]*$/ { on=1; next }
      on && /^##[[:space:]]+/ { exit }
      on && NF { print; exit }
    ' "$task_file" 2>/dev/null)"
  fi
  mkdir -p "$dir"
  if [ ! -f "$dir/CONTEXT.md" ]; then
    cat > "$dir/CONTEXT.md" <<EOF
# Workstream Context - $task / $agent

> status: active | task: $task | owner: $agent | merge: pending | kind: $kind

## Goal

${goal:-See engine/tasks/$task.md}

## Progress

- pending

## Changed Paths

- none

## Evidence

- none

## Merge Notes

- Coordinator re-reads this shard before updating shared engine/CONTEXT.md and engine/HANDOFF.md.
EOF
  fi
  if [ ! -f "$dir/HANDOFF.md" ]; then
    cat > "$dir/HANDOFF.md" <<EOF
# Workstream Handoff - $task / $agent

> updated: pending | merge: pending | kind: $kind

## Latest

- Completed: none
- Next: start assigned unit
- Blockers: none
- Verification: not run
EOF
  fi
  # v6.11.0 (D-029/T-036) AC-8: --kind=session creates .role=worker marker for top-level session degradation
  if [ "$kind" = "session" ]; then
    sessions_dir="$root/engine/.cache/sessions"
    mkdir -p "$sessions_dir" 2>/dev/null || true
    role_marker="$sessions_dir/$agent.role=worker"
    : > "$role_marker" 2>/dev/null || true
    echo "Session-degraded worker marker created: engine/.cache/sessions/$agent.role=worker"
    echo "Top-level session will be treated as worker by PreToolUse hook (signal 2)."
  fi
  # v6.11.1 (D-029/T-038) AC-5: 显示新目录路径(kind=agents|sessions, prefix=a-|s-)
  case "$kind" in
    subagent) ws_path="engine/workstreams/$task/agents/a-$agent" ;;
    session)  ws_path="engine/workstreams/$task/sessions/s-$agent" ;;
  esac
  echo "Workstream ready: $ws_path/"
  echo "Worker writes only this shard; coordinator owns shared CONTEXT/HANDOFF."
  echo "Kind: $kind (directory: agents/ for subagent, sessions/ for session)"
  if [ -n "$print_flag" ]; then
    cat "$dir/CONTEXT.md"
    cat "$dir/HANDOFF.md"
  fi
}

# v6.11.0 (D-029/T-036) AC-9: assume-coordinator command
# Force-take the coordinator lock; optionally write tombstone for the previous holder.
# Use cases: (1) crash recovery when a previous coordinator left a stale lock;
#            (2) explicit override of an active coordinator (--force required).
assume_coordinator() {
  local root="$1"
  shift 2>/dev/null || shift "$#"
  local force=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force="1" ;;
      *) echo "Warning: unknown flag '$1' (ignored)" >&2 ;;
    esac
    shift
  done

  local cache_dir="$root/engine/.cache"
  local lock_file="$cache_dir/session.lock"
  local tombstone_file="$cache_dir/session.tombstone"
  mkdir -p "$cache_dir" 2>/dev/null || true

  local pid="$$"
  # v6.11.1 (D-029/T-038) AC-3: UUID fallback 替换 anon-PID(PID 复用风险)
  local session_id="${CLAUDE_SESSION_ID:-$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || printf 'fallback-%s' "$(date +%s%N 2>/dev/null || date +%s)")}"
  local started_at
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '%s' '')"

  # Detect active task from engine/tasks/T-NNN.md (skip .spec.md twins)
  local task_id=""
  for task_file in "$root"/engine/tasks/T-*.md; do
    [ -f "$task_file" ] || continue
    case "$task_file" in *.spec.md) continue ;; esac
    if grep -q 'status:[[:space:]]*active' "$task_file" 2>/dev/null; then
      task_id="$(basename "$task_file" .md)"
      break
    fi
  done

  # Check existing lock
  if [ -f "$lock_file" ]; then
    local lock_content lock_pid lock_sid
    lock_content="$(cat "$lock_file" 2>/dev/null || true)"
    lock_pid="$(printf '%s' "$lock_content" | cut -d'|' -f1)"
    lock_sid="$(printf '%s' "$lock_content" | cut -d'|' -f2)"
    if [ -z "$force" ]; then
      echo "Error: lock held by pid=$lock_pid sid=$lock_sid" >&2
      echo "Use 'engine assume-coordinator --force' to override (writes tombstone for old holder)." >&2
      return 2
    fi
    # Force-override: write tombstone for the old coordinator, then take the lock
    rm -f "$lock_file" 2>/dev/null || true
    printf '%s|%s|forced-replaced\n' "$started_at" "${lock_pid:-unknown}" > "$tombstone_file" 2>/dev/null || true
    echo "Previous coordinator (pid=$lock_pid sid=$lock_sid) force-replaced."
    echo "Tombstone written: engine/.cache/session.tombstone"
  else
    # Fresh coordinator: clear any stale tombstone from a prior crash
    if [ -f "$tombstone_file" ]; then
      rm -f "$tombstone_file" 2>/dev/null || true
      echo "Cleared stale tombstone from prior coordinator exit."
    fi
  fi

  # Create new lock (atomic via noclobber when no prior lock; force case already removed old)
  printf '%s|%s|coordinator|%s|%s\n' "$pid" "$session_id" "$started_at" "${task_id:-}" > "$lock_file" 2>/dev/null || {
    echo "Error: failed to create lock file at $lock_file" >&2
    return 2
  }

  echo "Lock acquired: engine/.cache/session.lock"
  printf '  pid=%s sid=%s role=coordinator started=%s task=%s\n' "$pid" "$session_id" "$started_at" "${task_id:-none}"
  echo ""
  echo "This session is now the coordinator. Other sessions will be treated as workers."
  echo "Run 'engine context' to view active sessions."
}

# v6.11.0 (D-029/T-036) AC-10: merge-workstream command
# Display a worker's workstream shard and guide the coordinator through merging it
# into shared engine/CONTEXT.md and engine/HANDOFF.md. Does NOT auto-write the
# shared memory; the coordinator is the sole writer of shared three-file memory.
merge_workstream() {
  local root="$1" session_id="$2"
  if [ -z "$session_id" ]; then
    echo "Usage: engine merge-workstream <session-id>" >&2
    echo "Lists active workstreams if <session-id> is omitted." >&2
    return 2
  fi

  local ws_root="$root/engine/workstreams"
  if [ ! -d "$ws_root" ]; then
    echo "Error: no workstreams directory at engine/workstreams/." >&2
    echo "Run 'engine workstream T-NNN AGENT --kind=session' to create a worker shard first." >&2
    return 2
  fi

  # Locate the shard by session-id (may live under any task/<session-id>/).
  local shard_dir=""
  local task_id=""
  for task_dir in "$ws_root"/T-*/; do
    [ -d "$task_dir" ] || continue
    if [ -d "$task_dir/$session_id" ]; then
      shard_dir="$task_dir/$session_id"
      task_id="$(basename "$task_dir")"
      break
    fi
  done

  if [ -z "$shard_dir" ]; then
    echo "Error: no workstream shard found for session-id '$session_id'." >&2
    echo "Available shards:" >&2
    local found=0
    for task_dir in "$ws_root"/T-*/; do
      [ -d "$task_dir" ] || continue
      for shard in "$task_dir"*/; do
        [ -d "$shard" ] || continue
        printf '  %s -> %s\n' "$(basename "$shard")" "$(basename "$task_dir")" >&2
        found=1
      done
    done
    [ "$found" -eq 0 ] && echo "  (none)" >&2
    return 2
  fi

  echo "Workstream shard: engine/workstreams/$task_id/$session_id/"
  echo "Task: $task_id | Worker: $session_id"
  echo ""
  echo "--- BEGIN shard CONTEXT.md ---"
  if [ -f "$shard_dir/CONTEXT.md" ]; then
    cat "$shard_dir/CONTEXT.md"
  else
    echo "(missing: $shard_dir/CONTEXT.md)"
  fi
  echo "--- END shard CONTEXT.md ---"
  echo ""
  echo "--- BEGIN shard HANDOFF.md ---"
  if [ -f "$shard_dir/HANDOFF.md" ]; then
    cat "$shard_dir/HANDOFF.md"
  else
    echo "(missing: $shard_dir/HANDOFF.md)"
  fi
  echo "--- END shard HANDOFF.md ---"
  echo ""
  echo "Merge steps for the coordinator:"
  echo "  1. Re-read the shard above (Goal / Progress / Changed Paths / Evidence / Merge Notes)."
  echo "  2. Diff against shared engine/CONTEXT.md and engine/HANDOFF.md:"
  echo "       diff -u engine/CONTEXT.md $shard_dir/CONTEXT.md"
  echo "       diff -u engine/HANDOFF.md $shard_dir/HANDOFF.md"
  echo "  3. Apply shard-specific progress / changed paths / evidence into shared memory."
  echo "  4. After merge, archive the shard: mv $shard_dir engine/workstreams/$task_id/.merged-$session_id/"
  echo "  5. Run 'engine verify $task_id' to confirm shared memory still passes AC."
  echo ""
  echo "Coordinator is the sole writer of shared engine/{CONTEXT,HANDOFF,ENGINE_MAP}.md."
  echo "Workers write only their own shard; merge-workstream never auto-writes shared memory."
}

# v6.11.0 (D-029/T-036) AC-17: disable-multi-session kill switch command
# Toggle engine/.cache/multi-session.disabled flag file to disable multi-session lock.
# When the flag file exists (or ENGINE_DISABLE_MULTI_SESSION=1 env var), SessionStart hook
# skips lock detection and all sessions degrade to single-session mode (v6.10.0 fail-open equivalent).
disable_multi_session() {
  local root="$1"
  shift 2>/dev/null || shift "$#"
  local action="on"
  while [ $# -gt 0 ]; do
    case "$1" in
      on|enable) action="on" ;;
      off|disable) action="off" ;;
      status) action="status" ;;
      *) echo "Warning: unknown arg '$1' (ignored)" >&2 ;;
    esac
    shift
  done
  local cache_dir="$root/engine/.cache"
  local flag_file="$cache_dir/multi-session.disabled"
  mkdir -p "$cache_dir" 2>/dev/null || true
  case "$action" in
    on)
      : > "$flag_file" 2>/dev/null || { echo "Error: cannot create $flag_file" >&2; return 2; }
      echo "Multi-session lock DISABLED. Flag file: engine/.cache/multi-session.disabled"
      echo "All future sessions will degrade to single-session mode (fail-open)."
      echo "To re-enable: engine disable-multi-session off"
      ;;
    off)
      if [ -f "$flag_file" ]; then
        rm -f "$flag_file" 2>/dev/null || { echo "Error: cannot remove $flag_file" >&2; return 2; }
        echo "Multi-session lock ENABLED. Flag file removed."
        echo "Future sessions will use coordinator/worker role assignment."
      else
        echo "Flag file does not exist — multi-session lock already enabled."
      fi
      ;;
    status)
      if [ -f "$flag_file" ]; then
        echo "Multi-session lock: DISABLED (flag file present)"
      elif [ -n "${ENGINE_DISABLE_MULTI_SESSION:-}" ]; then
        echo "Multi-session lock: DISABLED (env var ENGINE_DISABLE_MULTI_SESSION=$ENGINE_DISABLE_MULTI_SESSION)"
      else
        echo "Multi-session lock: ENABLED"
      fi
      ;;
  esac
}

download() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -sSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    echo "Error: curl or wget is required." >&2
    exit 1
  fi
}

# 归一化:补足 major.minor.patch(6.0 -> 6.0.0);非纯数字版本原样返回(D-015)。
normalize_version() {
  local v
  v="$(printf '%s' "${1:-}" | tr -d '[:space:]')"
  case "$v" in
    ''|*[!0-9.]*) printf '%s' "$v"; return ;;
  esac
  case "$v" in
    *.*.*) ;;
    *.*) v="$v.0" ;;
    *) v="$v.0.0" ;;
  esac
  printf '%s' "$v"
}

# $1 > $2 ?(两侧须已归一化;相等不算大于)
version_gt() {
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# 版本化迁移调度(D-015):发现 engine/migrations/v*.sh -> sort -V -> 仅应用
# 新于本地 engine/VERSION 的步 -> 每步成功后回写 VERSION。
# 无待应用步时回退直接跑契约迁移器(保留 `engine migrate` 的幂等修复语义)。
run_migrate() {
  local root="$1"
  local migrator="$root/engine/scripts/engine-migrate-contract.sh"
  local mig_dir="$root/engine/migrations"
  local vfile="$root/engine/VERSION"
  local current="0"
  [ -f "$vfile" ] && current="$(tr -d '[:space:]' < "$vfile")"
  current="$(normalize_version "$current")"
  case "$current" in ''|*[!0-9.]*) current="0.0.0" ;; esac
  local applied=0 step step_v
  if [ -d "$mig_dir" ]; then
    # 按"归一化版本列"排序而非文件名:v6.0.sh 的文件名在 sort -V 里会排在
    # v6.0.1.sh 之后(digit < letter),直接排文件名会让低版本步被跳过。
    while IFS=' ' read -r step_v step; do
      [ -n "$step" ] || continue
      if version_gt "$step_v" "$current"; then
        echo "[engine] applying migration step $(basename "$step") ($current -> $step_v)..."
        if bash "$step" "$root"; then
          printf '%s\n' "$step_v" > "$vfile"   # VERSION 回写:每步成功后推进
          current="$step_v"
          applied=$((applied + 1))
        else
          echo "[engine] migration step $(basename "$step") failed - stopping (VERSION stays $current)" >&2
          return 1
        fi
      fi
    done < <(
      for f in "$mig_dir"/v*.sh; do
        [ -f "$f" ] || continue
        b="$(basename "$f" .sh)"
        case "$b" in v[0-9]*) ;; *) continue ;; esac
        printf '%s %s\n' "$(normalize_version "${b#v}")" "$f"
      done | sort -V
    )
  fi
  if [ "$applied" -eq 0 ]; then
    if [ -f "$migrator" ]; then
      echo "[engine] no pending migration steps (local $current) - running contract migrator (idempotent repair)..."
      bash "$migrator" "$root" || echo "[engine] migration reported issues (see above)" >&2
    else
      echo "[engine] migrator not found at $migrator - skipping migrate" >&2
    fi
  fi
}

run_doctor() {
  local root="$1"
  local doctor="$root/engine/scripts/engine-doctor.sh"
  if [ -f "$doctor" ]; then
    echo "[engine] running doctor..."
    bash "$doctor" "$root" || echo "[engine] doctor reported issues (see above)" >&2
  fi
}

# load_engine: 重新铺设引擎工具的外部副作用(PATH shim + git hook)。
# 不拉远程、不跑 migrate/doctor。用于切分支/修 clobber/重链 local 检出。
# .claude/settings.json 由 installer/engine-sync 维护,本命令不修。
load_engine() {
  local root="$1"
  local src_dir="$root/engine/bin"
  local dest_dir="${HOME:-}/.local/bin"
  if [ -z "${HOME:-}" ]; then
    echo "Error: HOME is not set - cannot determine user-level bin dir." >&2
    return 2
  fi
  if [ ! -f "$src_dir/engine" ]; then
    echo "Error: $src_dir/engine not found. Engine tooling is missing - run the installer first." >&2
    return 2
  fi
  mkdir -p "$dest_dir"
  local installed=0 f
  for f in engine engine.ps1 engine.cmd; do
    if [ -f "$src_dir/$f" ]; then
      cp "$src_dir/$f" "$dest_dir/$f"
      chmod +x "$dest_dir/$f" 2>/dev/null || true
      echo "  installed  $dest_dir/$f"
      installed=$((installed + 1))
    fi
  done
  case ":$PATH:" in
    *":$dest_dir:"*) ;;
    *) echo "Note: $dest_dir is not in PATH. Add it to run 'engine' globally." ;;
  esac

  # git pre-commit hook(仅当目标不存在或是 engine-managed 时重装)
  local hook_src="$root/engine/scripts/githooks/pre-commit"
  if [ -f "$hook_src" ] && command -v git >/dev/null 2>&1; then
    local git_dir
    git_dir="$(git -C "$root" rev-parse --git-dir 2>/dev/null || true)"
    if [ -n "$git_dir" ]; then
      local hook_path="$git_dir/hooks/pre-commit"
      mkdir -p "$(dirname "$hook_path")"
      if [ ! -f "$hook_path" ] || grep -q 'Engine System.*pre-commit hook' "$hook_path" 2>/dev/null; then
        cp "$hook_src" "$hook_path"
        chmod +x "$hook_path" 2>/dev/null || true
        echo "  installed  $hook_path"
        installed=$((installed + 1))
      else
        echo "  keep       $hook_path (user-defined)"
      fi
    fi
  fi

  echo ""
  echo "Engine external side-effects reloaded. ($installed items)"
  echo "Project tooling under engine/ is unchanged. Run 'engine update' to refresh from remote."
}

# unload_engine: 拆掉所有引擎工具 + 外部副作用。保留用户项目记忆和根锚点。
# 白名单删除策略:只删 install.sh 铺设的引擎工具路径,其余全保留。
unload_engine() {
  local root="$1"
  local removed=0 skipped=0

  # 1. PATH shim
  local dest_dir="${HOME:-}/.local/bin"
  if [ -n "${HOME:-}" ] && [ -d "$dest_dir" ]; then
    local f
    for f in engine engine.ps1 engine.cmd; do
      if [ -f "$dest_dir/$f" ]; then
        rm -f "$dest_dir/$f"
        echo "  removed    $dest_dir/$f"
        removed=$((removed + 1))
      fi
    done
  fi

  # 2. git pre-commit hook(仅当 engine-managed)
  if command -v git >/dev/null 2>&1; then
    local git_dir
    git_dir="$(git -C "$root" rev-parse --git-dir 2>/dev/null || true)"
    if [ -n "$git_dir" ] && [ -f "$git_dir/hooks/pre-commit" ]; then
      if grep -q 'Engine System.*pre-commit hook' "$git_dir/hooks/pre-commit" 2>/dev/null; then
        rm -f "$git_dir/hooks/pre-commit"
        echo "  removed    $git_dir/hooks/pre-commit (was engine-managed)"
        removed=$((removed + 1))
      else
        echo "  keep       $git_dir/hooks/pre-commit (user-defined)"
        skipped=$((skipped + 1))
      fi
    fi
  fi

  # 3. .claude/settings.json(仅当含 _engine_system 标记——install 生成的 managed 块)
  local settings="$root/.claude/settings.json"
  if [ -f "$settings" ] && grep -q '"_engine_system"' "$settings" 2>/dev/null; then
    rm -f "$settings"
    echo "  removed    $settings (engine-managed)"
    removed=$((removed + 1))
  fi

  # 4. 引擎工具目录(白名单,只删这些)
  local tool_dirs=(
    "$root/engine/bin"
    "$root/engine/scripts"
    "$root/engine/prompts"
    "$root/engine/migrations"
    "$root/.claude/commands"
    "$root/.claude/skills"
  )
  local d
  for d in "${tool_dirs[@]}"; do
    if [ -d "$d" ]; then
      rm -rf "$d"
      echo "  removed    $d"
      removed=$((removed + 1))
    fi
  done

  # 5. 引擎工具单文件(白名单)
  local tool_files=(
    "$root/runtime-law.md"
    "$root/engine/VERSION"
    "$root/engine/domains/routing.json"
  )
  local tf
  for tf in "${tool_files[@]}"; do
    if [ -f "$tf" ]; then
      rm -f "$tf"
      echo "  removed    $tf"
      removed=$((removed + 1))
    fi
  done

  echo ""
  echo "Engine tooling unloaded. ($removed items removed, $skipped user-owned kept)"
  echo "Preserved: engine/CONTEXT.md, engine/HANDOFF.md, engine/ENGINE_MAP.md,"
  echo "          engine/SYSTEM.md, engine/AGENT_ADAPTERS.md, engine/ENGINE_DOCTOR.md,"
  echo "          engine/{tasks,decisions,changes,evidence,workstreams,domains,checks},"
  echo "          CLAUDE.md, AGENTS.md, and your project source."
  echo ""
  echo "To reinstall: bash install.sh   (or   bash install.sh --update   to keep memory)"
}

# Parse global flags (apply to `update`).
NO_MIGRATE=false
CHECK_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --no-migrate) NO_MIGRATE=true ;;
    --check-only) CHECK_ONLY=true ;;
  esac
done

case "${1:-help}" in
  init)
    prompt_rel="engine/prompts/init.md"
    prompt_file="$PWD/$prompt_rel"
    if [ ! -f "$prompt_file" ]; then
      echo "Error: $prompt_rel not found in $PWD." >&2
      echo "Run 'engine update' (or re-run the installer) to fetch the init prompt, then retry." >&2
      exit 2
    fi
    if [ "${2:-}" = "--print" ]; then
      cat "$prompt_file"
      exit 0
    fi
    echo "Engine System init — agent-neutral entry point"
    echo ""
    if [ -f "$PWD/engine/ENGINE_MAP.md" ]; then
      echo "Note: engine/ENGINE_MAP.md already exists — this project looks initialized."
      echo "Prefer /engine-reconcile (in your agent) or 'engine migrate' instead of re-init."
      echo ""
    fi
    echo "The init interview prompt lives at: $prompt_rel"
    echo "Feed it to whichever AI agent you use:"
    echo ""
    echo "  Claude Code   type /engine-init in this project"
    echo "  claude CLI    claude \"\$(cat $prompt_rel)\""
    echo "  codex CLI     codex \"\$(cat $prompt_rel)\""
    echo "  copilot CLI   copilot -p \"\$(cat $prompt_rel)\""
    echo "  Web chat      paste the contents of $prompt_rel into the chat"
    echo "  Raw prompt    engine init --print"
    ;;
  verify)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD. Run 'engine verify' in a project root." >&2
      exit 2
    fi
    task="${2:-}"
    if [ -z "$task" ]; then
      echo "Usage: engine verify T-NNN" >&2
      exit 2
    fi
    bash "$PWD/engine/scripts/engine-verify.sh" "$task"
    ;;
  context)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD. Run 'engine init' first." >&2
      exit 2
    fi
    bash "$PWD/engine/scripts/engine-context.sh" "$PWD"
    ;;
  workstream)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    create_workstream "$PWD" "${2:-}" "${3:-}" "${4:-}"
    ;;
  assume-coordinator)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    assume_coordinator "$PWD" "${2:-}"
    ;;
  merge-workstream)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    merge_workstream "$PWD" "${2:-}"
    ;;
  disable-multi-session)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    disable_multi_session "$PWD" "${2:-}"
    ;;
  check-update)
    bash "$PWD/engine/scripts/engine-check-update.sh" "$PWD"
    ;;
  migrate)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    run_migrate "$PWD"
    ;;
  update)
    if $CHECK_ONLY; then
      bash "$PWD/engine/scripts/engine-check-update.sh" "$PWD"
      exit $?
    fi
    tmp="$(mktemp -t engine-install.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    download "https://raw.githubusercontent.com/${REPO}/${BRANCH}/install.sh" "$tmp"
    bash "$tmp" --update
    echo ""
    if ! $NO_MIGRATE; then
      run_migrate "$PWD"
      run_doctor "$PWD"
    fi
    echo ""
    echo "Engine tooling updated from remote."
    if ! $NO_MIGRATE; then
      echo "Migration + doctor complete."
    fi
    echo "Next: run /engine-sync in your AI agent if cross-agent anchors need syncing."
    ;;
  doctor)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD. Run 'engine init' first." >&2
      exit 2
    fi
    run_doctor "$PWD"
    ;;
  load)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD. Run 'engine init' or the installer first." >&2
      exit 2
    fi
    load_engine "$PWD"
    ;;
  unload)
    unload_engine "$PWD"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
