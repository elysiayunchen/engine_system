#!/usr/bin/env bash
# Engine System user-level CLI shim.

set -e

REPO="${ENGINE_SYSTEM_REPO:-elysiayunchen/engine_system}"
BRANCH="${ENGINE_SYSTEM_BRANCH:-main}"

usage() {
  cat <<'EOF'
Engine System CLI

Usage:
  engine check-update   Check if a newer Engine System version is available
  engine update         Update tooling, then migrate + doctor (one-shot)
  engine update --check-only   Only check for updates, change nothing
  engine update --no-migrate   Update tooling but skip migration/doctor
  engine migrate        Run contract migration on existing engine files
  engine verify T-NNN   Run behavior verification for a task card
  engine help           Show this help

`engine check-update` compares local engine/VERSION against the remote VERSION.
Exit codes: 0 = up to date | 7 = update available | 8 = network error.

`engine update` downloads the latest installer, runs update mode (does not
overwrite project-specific engine/*.md memory), then runs the contract migrator
so old engine files receive the v6 data-layer structure and managed contract
block, then runs Doctor to verify. Use --check-only to preview, --no-migrate to
skip the migration step.

`engine migrate` applies migration steps under engine/migrations/ that are
newer than the local engine/VERSION, in version order (sort -V), writing the
version back after each step. When nothing is pending it falls back to the
idempotent contract migrator, so it still repairs/re-applies the v6 structure.
EOF
}

download() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -sSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    echo "Error: curl or wget is required." >&2
    exit 1
  fi
}

# 归一化:补足 major.minor.patch(6.0 -> 6.0.0);非纯数字版本原样返回(D-015)。
normalize_version() {
  local v
  v="$(printf '%s' "${1:-}" | tr -d '[:space:]')"
  case "$v" in
    ''|*[!0-9.]*) printf '%s' "$v"; return ;;
  esac
  case "$v" in
    *.*.*) ;;
    *.*) v="$v.0" ;;
    *) v="$v.0.0" ;;
  esac
  printf '%s' "$v"
}

# $1 > $2 ?(两侧须已归一化;相等不算大于)
version_gt() {
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# 版本化迁移调度(D-015):发现 engine/migrations/v*.sh -> sort -V -> 仅应用
# 新于本地 engine/VERSION 的步 -> 每步成功后回写 VERSION。
# 无待应用步时回退直接跑契约迁移器(保留 `engine migrate` 的幂等修复语义)。
run_migrate() {
  local root="$1"
  local migrator="$root/engine/scripts/engine-migrate-contract.sh"
  local mig_dir="$root/engine/migrations"
  local vfile="$root/engine/VERSION"
  local current="0"
  [ -f "$vfile" ] && current="$(tr -d '[:space:]' < "$vfile")"
  current="$(normalize_version "$current")"
  case "$current" in ''|*[!0-9.]*) current="0.0.0" ;; esac
  local applied=0 step step_v
  if [ -d "$mig_dir" ]; then
    # 按"归一化版本列"排序而非文件名:v6.0.sh 的文件名在 sort -V 里会排在
    # v6.0.1.sh 之后(digit < letter),直接排文件名会让低版本步被跳过。
    while IFS=' ' read -r step_v step; do
      [ -n "$step" ] || continue
      if version_gt "$step_v" "$current"; then
        echo "[engine] applying migration step $(basename "$step") ($current -> $step_v)..."
        if bash "$step" "$root"; then
          printf '%s\n' "$step_v" > "$vfile"   # VERSION 回写:每步成功后推进
          current="$step_v"
          applied=$((applied + 1))
        else
          echo "[engine] migration step $(basename "$step") failed - stopping (VERSION stays $current)" >&2
          return 1
        fi
      fi
    done < <(
      for f in "$mig_dir"/v*.sh; do
        [ -f "$f" ] || continue
        b="$(basename "$f" .sh)"
        case "$b" in v[0-9]*) ;; *) continue ;; esac
        printf '%s %s\n' "$(normalize_version "${b#v}")" "$f"
      done | sort -V
    )
  fi
  if [ "$applied" -eq 0 ]; then
    if [ -f "$migrator" ]; then
      echo "[engine] no pending migration steps (local $current) - running contract migrator (idempotent repair)..."
      bash "$migrator" "$root" || echo "[engine] migration reported issues (see above)" >&2
    else
      echo "[engine] migrator not found at $migrator - skipping migrate" >&2
    fi
  fi
}

run_doctor() {
  local root="$1"
  local doctor="$root/engine/scripts/engine-doctor.sh"
  if [ -f "$doctor" ]; then
    echo "[engine] running doctor..."
    bash "$doctor" "$root" || echo "[engine] doctor reported issues (see above)" >&2
  fi
}

# Parse global flags (apply to `update`).
NO_MIGRATE=false
CHECK_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --no-migrate) NO_MIGRATE=true ;;
    --check-only) CHECK_ONLY=true ;;
  esac
done

case "${1:-help}" in
  verify)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD. Run 'engine verify' in a project root." >&2
      exit 2
    fi
    task="${2:-}"
    if [ -z "$task" ]; then
      echo "Usage: engine verify T-NNN" >&2
      exit 2
    fi
    bash "$PWD/engine/scripts/engine-verify.sh" "$task"
    ;;
  check-update)
    bash "$PWD/engine/scripts/engine-check-update.sh" "$PWD"
    ;;
  migrate)
    if [ ! -d "$PWD/engine" ]; then
      echo "Error: engine/ not found in $PWD." >&2
      exit 2
    fi
    run_migrate "$PWD"
    ;;
  update)
    if $CHECK_ONLY; then
      bash "$PWD/engine/scripts/engine-check-update.sh" "$PWD"
      exit $?
    fi
    tmp="$(mktemp -t engine-install.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    download "https://raw.githubusercontent.com/${REPO}/${BRANCH}/install.sh" "$tmp"
    bash "$tmp" --update
    echo ""
    if ! $NO_MIGRATE; then
      run_migrate "$PWD"
      run_doctor "$PWD"
    fi
    echo ""
    echo "Engine tooling updated from remote."
    if ! $NO_MIGRATE; then
      echo "Migration + doctor complete."
    fi
    echo "Next: run /engine-sync in your AI agent if cross-agent anchors need syncing."
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
