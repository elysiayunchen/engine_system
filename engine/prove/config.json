{
  "defaults": {
    "assertion_timeout_s": 30,
    "max_assertions": 10,
    "output_truncate_chars": 500,
    "blocked_commands": ["rm", "mv", "curl", "wget", "sudo", "dd", "mkfs", "chmod", "chown", "kill", "shutdown", "reboot", "format"],
    "syntax_checkers": {
      ".sh": "bash -n {file}",
      ".py": "python -m py_compile {file}",
      ".js": "node --check {file}",
      ".json": "python -m json.tool {file}",
      ".ts": "npx tsc --noEmit {file}"
    },
    "gate_policy": "all_pass",
    "code_extensions": [".sh", ".ps1", ".py", ".js", ".ts", ".go", ".rs", ".java", ".c", ".cpp", ".rb", ".php"]
  },
  "overrides": {}
}
