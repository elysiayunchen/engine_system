{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProveAssertions",
  "description": "Agent-generated test assertions for engine prove --execute",
  "type": "object",
  "required": ["task_id", "code_fingerprint", "assertions"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "code_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Must match prove-package fingerprint (staleness guard)"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "category", "command", "expect_exit", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]{2}$"
          },
          "category": {
            "type": "string",
            "enum": ["syntax", "regression", "invariant"]
          },
          "command": {
            "type": "string",
            "maxLength": 500
          },
          "expect_exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "expect_output_contains": {
            "type": "string",
            "maxLength": 200
          },
          "expect_output_not_contains": {
            "type": "string",
            "maxLength": 200
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 30
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          },
          "revert_would_fail": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
