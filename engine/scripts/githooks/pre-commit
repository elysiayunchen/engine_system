#!/bin/sh
# Engine System - agent-neutral commit gate.
# 1. Enforce task WRITE-SET/FORBIDDEN for every staged project path, including engine files.
#    v6.12.0 (D-035): union gating across ALL active cards - a path passes when at
#    least one governing card lists it in WRITE-SET and not in that card's FORBIDDEN.
# 2. Require project-memory write-back for code changes.
# 3. Require approved decisions for protected paths (per covering card).
# 4. Warn when root anchors gain unsourced rules.

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
ENGINE_DIR="$ROOT/engine"
TAB="$(printf '\t')"

staged="$(git diff --cached --name-only -z 2>/dev/null | tr '\0' '\n')"
[ -n "$staged" ] || exit 0

is_strict_task_project() {
  _version=""
  for _marker in "$ROOT/AGENTS.md" "$ENGINE_DIR/SYSTEM.md" "$ENGINE_DIR/ENGINE_DOCTOR.md"; do
    [ -f "$_marker" ] || continue
    _version="$(sed -n 's/.*contract-version:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' "$_marker" 2>/dev/null | head -1)"
    [ -n "$_version" ] && break
  done
  [ -n "$_version" ] || return 1
  _major="${_version%%.*}"
  _minor="${_version#*.}"; _minor="${_minor%%.*}"
  case "$_major:$_minor" in *[!0-9:]*|:*) return 1 ;; esac
  [ "$_major" -gt 6 ] 2>/dev/null || { [ "$_major" -eq 6 ] 2>/dev/null && [ "$_minor" -ge 5 ] 2>/dev/null; }
}

is_task_bootstrap_path() {
  case "$1" in engine/tasks/T-*.md|engine/decisions/D-*.md) return 0 ;; *) return 1 ;; esac
}

strict_task_mode=0
is_strict_task_project && strict_task_mode=1

parse_task_patterns() {
  _field="$1"; _file="$2"
  _inline="$(grep "^${_field}:" "$_file" 2>/dev/null | head -1 | sed "s/^${_field}:[[:space:]]*//;s/\r$//")"
  if [ -n "$_inline" ]; then
    printf '%s' "$_inline"
    return 0
  fi
  awk -v field="$_field" '
    BEGIN { in_section=0; in_frontmatter_block=0; in_frontmatter_field=0; out=""; field_lc=tolower(field) }
    {
      sub(/\r$/, "")
      # YAML frontmatter block boundary (--- open/close)
      if ($0 ~ /^---[[:space:]]*$/) {
        in_frontmatter_block = !in_frontmatter_block
        in_frontmatter_field = 0
        next
      }
      line_lc = tolower($0)
      # markdown section header (## field, case-insensitive)
      if (line_lc ~ "^##[[:space:]]+" field_lc "[[:space:]]*$") { in_section=1; in_frontmatter_field=0; next }
      if (in_section && $0 ~ "^##[[:space:]]+") { exit }
      # YAML frontmatter field header (field:, case-insensitive, only inside frontmatter_block)
      if (in_frontmatter_block && line_lc ~ "^" field_lc ":$") {
        in_frontmatter_field=1; in_section=0; next
      }
      # frontmatter field exit: non-indented non-empty line
      if (in_frontmatter_field && $0 !~ /^[[:space:]]/ && $0 != "") { in_frontmatter_field=0 }
      # collect frontmatter field list items (indented - entries)
      if (in_frontmatter_field && $0 ~ /^[[:space:]]+-[[:space:]]+/) {
        sub(/^[[:space:]]+-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
        next
      }
      # collect markdown section list items (original logic)
      if (in_section && $0 ~ "^-[[:space:]]+") {
        sub(/^-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
      }
    }
    END { print out }
  ' "$_file" 2>/dev/null
}

match_any_glob() {
  _path="$1"; _pats="$2"; _old="$IFS"
  set -f
  IFS=','
  for _p in $_pats; do
    # Trim via parameter expansion - no subshells. A sed pipe here costs two
    # process spawns per glob token, which on Windows turns a large commit
    # (many staged files x many WRITE-SET entries) into minutes of hang.
    _p="${_p#"${_p%%[![:space:]]*}"}"
    _p="${_p%"${_p##*[![:space:]]}"}"
    [ -n "$_p" ] || continue
    # v6.12.1 (issue #11 B-3): a bare directory entry also matches its children.
    case "$_path" in $_p|$_p/*) IFS="$_old"; set +f; return 0 ;; esac
  done
  IFS="$_old"
  set +f
  return 1
}

# v6.12.0 (D-035) RC-1 fix: every active card governs, plus every staged card
# being closed (status done in the index). The old single-card pick (lex-first
# active) judged other sessions' files against the wrong card. (P037 heritage,
# T-044/D-032: done cards on disk stay cold and never govern.)
governing_files=""
for _f in "$ENGINE_DIR"/tasks/T-*.md; do
  [ -f "$_f" ] || continue
  case "$_f" in *.spec.md) continue ;; esac
  # v6.12.1 (issue #11 C-1): anchored - unanchored matching pinned done cards
  # whose PROSE merely quoted the pattern, locking the repo.
  grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*active' "$_f" 2>/dev/null || continue
  governing_files="${governing_files}${governing_files:+
}$_f"
done
closing_paths="$(printf '%s\n' "$staged" | grep -E '^engine/tasks/T-[0-9]+\.md$' | while IFS= read -r _task_path; do
  if git -C "$ROOT" show ":$_task_path" 2>/dev/null | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done'; then
    printf '%s\n' "$ROOT/$_task_path"
  fi
done)"
if [ -n "$closing_paths" ]; then
  governing_files="${governing_files}${governing_files:+
}$closing_paths"
fi

# Pre-parse each governing card once: <file>TAB<id>TAB<write-set>TAB<forbidden>
card_meta=""
card_id_list=""
old_ifs="$IFS"; IFS='
'
for _f in $governing_files; do
  [ -n "$_f" ] || continue
  IFS="$old_ifs"
  _id="$(basename "$_f" .md)"
  _ws="$(parse_task_patterns WRITE-SET "$_f")"
  _fb="$(parse_task_patterns FORBIDDEN "$_f")"
  card_meta="${card_meta}${card_meta:+
}${_f}${TAB}${_id}${TAB}${_ws}${TAB}${_fb}"
  card_id_list="${card_id_list:+$card_id_list, }$_id"
  IFS='
'
done
IFS="$old_ifs"

# Union check: pass when at least one card's WRITE-SET covers the path and that
# same card's FORBIDDEN does not. One card's FORBIDDEN never vetoes another card.
union_allows() {
  _upath="$1"
  [ -n "$card_meta" ] || return 1
  while IFS="$TAB" read -r _cf _cid _cws _cfb; do
    [ -n "$_cid" ] || continue
    [ -n "$_cws" ] || continue
    if [ -n "$_cfb" ] && match_any_glob "$_upath" "$_cfb"; then continue; fi
    if match_any_glob "$_upath" "$_cws"; then return 0; fi
  done <<UNION_EOF
$card_meta
UNION_EOF
  return 1
}

# Print the decision id of the first card covering the path (for protected paths).
covering_decision() {
  _dpath="$1"
  [ -n "$card_meta" ] || return 1
  while IFS="$TAB" read -r _cf _cid _cws _cfb; do
    [ -n "$_cid" ] || continue
    [ -n "$_cws" ] || continue
    if [ -n "$_cfb" ] && match_any_glob "$_dpath" "$_cfb"; then continue; fi
    if match_any_glob "$_dpath" "$_cws"; then
      grep 'decision:' "$_cf" 2>/dev/null | head -1 | sed 's/.*decision:[[:space:]]*//' | sed 's/[[:space:]|].*//'
      return 0
    fi
  done <<COVER_EOF
$card_meta
COVER_EOF
  return 1
}

if [ -z "$card_meta" ] && [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    is_task_bootstrap_path "$file" && continue
    printf '\n[Engine System] No active task card governs %s; commit blocked.\n' "$file" >&2
    printf 'Create or activate engine/tasks/T-NNN.md before staging ordinary project changes.\n\n' >&2
    IFS="$old_ifs"
    exit 1
  done
  IFS="$old_ifs"
fi

if [ -n "$card_meta" ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    # Bootstrap channel (D-035): task/decision card files commit freely; the
    # protected-path check below still applies its own per-card rules.
    is_task_bootstrap_path "$file" && continue
    # Workstream shards are the sanctioned worker write channel.
    case "$file" in engine/workstreams/*/*/*) continue ;; esac
    if ! union_allows "$file"; then
      printf '\n[Engine System] %s is outside the WRITE-SET of every governing card (%s); commit blocked.\n' "$file" "$card_id_list" >&2
      printf 'Add the path to YOUR card WRITE-SET (outside its FORBIDDEN), or split the commit per card.\n\n' >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

# In v6.5+ a task cannot cross active -> done on declaration alone. Every AC in
# the staged card must have a staged/committed PASS evidence record, unless the
# card carries an architect-approved exempt marker.
if [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for task_path in $staged; do
    case "$task_path" in engine/tasks/T-*.md) ;; *) continue ;; esac
    task_snapshot="$(git -C "$ROOT" show ":$task_path" 2>/dev/null || true)"
    printf '%s\n' "$task_snapshot" | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done' || continue
    printf '%s\n' "$task_snapshot" | grep -qi 'exempt' && continue
    done_task_id="$(basename "$task_path" .md)"
    ac_ids="$(printf '%s\n' "$task_snapshot" | sed -n 's/^AC:[[:space:]]*\(AC-[0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/p')"
    if [ -z "$ac_ids" ]; then
      printf '\n[Engine System] %s is staged as done but declares no AC evidence targets.\n\n' "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    for ac_id in $ac_ids; do
      evidence_path="engine/evidence/$done_task_id/$ac_id.json"
      evidence="$(git -C "$ROOT" show ":$evidence_path" 2>/dev/null || true)"
      if ! printf '%s\n' "$evidence" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"pass"'; then
        printf '\n[Engine System] %s cannot be marked done: %s has no PASS evidence.\n' "$done_task_id" "$ac_id" >&2
        printf "Run 'engine verify %s' and stage engine/evidence/%s/.\n\n" "$done_task_id" "$done_task_id" >&2
        IFS="$old_ifs"
        exit 1
      fi
    done
  done
  IFS="$old_ifs"
fi

# v6.11.1 (D-029/T-038) AC-4: B tier pre-commit backstop - with ENGINE_WORKER=1
# set, refuse staging the shared memory trio (Codex/Cursor/Aider have no
# SessionStart hook to write the .role=worker flag; the user sets the env var).
if [ "${ENGINE_WORKER:-}" = "1" ]; then
  shared_staged="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$' | head -1)"
  if [ -n "$shared_staged" ]; then
    printf '\n[Engine System] Worker mode (ENGINE_WORKER=1) cannot stage shared memory: %s\n' "$shared_staged" >&2
    printf 'Stage your engine/workstreams/<task>/<sid>/ shard instead.\n\n' >&2
    exit 1
  fi
fi

# Code changes must carry shared memory or a worker shard in the same commit.
code_changed="$(printf '%s\n' "$staged" | grep -vE '^(engine/|\.engine/)' | head -1)"
memory_written="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$|^engine/workstreams/[^/]+/[^/]+/(CONTEXT|HANDOFF)\.md$' | head -1)"
if [ -n "$code_changed" ] && [ -z "$memory_written" ]; then
  printf '\n[Engine System] Code changed but project memory was not staged.\n' >&2
  printf 'Coordinator: update engine/CONTEXT.md or engine/HANDOFF.md.\n' >&2
  printf 'Parallel worker: stage your engine/workstreams/<task>/<agent>/ shard.\n\n' >&2
  exit 1
fi

rules_file="$ENGINE_DIR/decisions/rules.json"
if [ -f "$rules_file" ]; then
  protected="$(sed -n '/"protected_paths"/,/\]/{
    /"protected_paths"/d
    /\]/d
    s/.*"\([^"]*\)".*/\1/p
  }' "$rules_file" 2>/dev/null)"
else
  protected=""
fi

# True when engine/tasks/T-NNN is active in the worktree or staged as done.
card_owns_itself() {
  _cid="$1"
  _card="$ENGINE_DIR/tasks/$_cid.md"
  if [ -f "$_card" ] && grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*active' "$_card" 2>/dev/null; then return 0; fi
  git -C "$ROOT" show ":engine/tasks/$_cid.md" 2>/dev/null | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done' && return 0
  return 1
}

if [ -n "$protected" ]; then
  # protected is newline-separated; normalize to comma-separated for match_any_glob.
  protected_csv="$(printf '%s\n' "$protected" | tr '\n' ',' | sed 's/,$//')"
  # v6.12.0 (D-035) RC-5 fix: exemption is per card ("every card exempts its own
  # files"), replacing the single lex-first exempt_id (T-041) that blocked a
  # lex-later card from committing itself while another card was active.
  # Decision cards are the bootstrap channel and commit freely; tampering is
  # guarded by git history + architect review, not by a write lock.
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    match_any_glob "$file" "$protected_csv" || continue
    case "$file" in
      engine/decisions/D-*.md) continue ;;
      engine/tasks/*)
        _base="${file#engine/tasks/}"
        _tid="${_base%%/*}"
        _tid="${_tid%.spec.md}"
        _tid="${_tid%.md}"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
      engine/archive/tasks/*-progress.md)
        _tid="$(basename "$file" | sed 's/-progress\.md$//')"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
    esac
    task_decision="$(covering_decision "$file" || true)"
    if [ -z "$task_decision" ] || [ "$task_decision" = "none" ]; then
      violation="$file (no covering card with a decision)"
    elif [ ! -f "$ENGINE_DIR/decisions/$task_decision.md" ]; then
      violation="$file (decision $task_decision missing)"
    elif ! grep -q 'status.*approved' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null; then
      violation="$file (decision $task_decision not approved)"
    else
      scope_line="$(grep 'scope' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null | head -1)"
      scope_raw="$(printf '%s' "$scope_line" | sed 's/.*scope[[:space:]]*[:|][[:space:]]*//' | sed 's/[[:space:]]*|.*//' | tr -d '\r')"
      if ! match_any_glob "$file" "$scope_raw"; then
        violation="$file (decision $task_decision scope does not cover it)"
      else
        violation=""
      fi
    fi
    if [ -n "$violation" ]; then
      printf '\n[Engine System] Protected path blocked: %s\n\n' "$violation" >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

for anchor in AGENTS.md CLAUDE.md; do
  printf '%s\n' "$staged" | grep -qx "$anchor" || continue
  suspect="$(git diff --cached -- "$anchor" 2>/dev/null | grep '^+' | grep -v '^+++' | grep -iE '(MUST|NEVER|ALWAYS)' | grep -vi 'source:' | wc -l | tr -d ' ')"
  if [ "$suspect" -gt 0 ]; then
    printf '\n[Engine System] Anchor warning: %s adds %s MUST/NEVER/ALWAYS line(s) without source:.\n\n' "$anchor" "$suspect" >&2
  fi
done

# T-051 (v6.12.3): dist-stale gate - if contract source or dist files are staged,
# verify working-tree dist == compile(src). Catches:
# (a) direct dist edits without source update
# (b) source changes without running bash contract/compile.sh
if [ -f "$ROOT/contract/compile.sh" ]; then
  _contract_touch="$(printf '%s\n' "$staged" | grep -E '^contract/src/|^(ENGINE_FILE_SYSTEM_v5\.md|runtime-law\.md|rules\.json|plugin/\.claude/commands/engine-init\.md|engine/prompts/init\.md|plugin/engine/prompts/init\.md)$' | head -1)"
  if [ -n "$_contract_touch" ]; then
    _tmpcompile="$(mktemp -d 2>/dev/null || mktemp -d -t engcompile)"
    if ENGINE_COMPILE_OUT="$_tmpcompile" bash "$ROOT/contract/compile.sh" >/dev/null 2>&1; then
      _stale=""
      for _df in \
        ENGINE_FILE_SYSTEM_v5.md \
        runtime-law.md \
        rules.json \
        plugin/.claude/commands/engine-init.md \
        engine/prompts/init.md \
        plugin/engine/prompts/init.md
      do
        if [ -f "$_tmpcompile/$_df" ] && [ -f "$ROOT/$_df" ]; then
          if ! diff -q "$_tmpcompile/$_df" "$ROOT/$_df" >/dev/null 2>&1; then
            _stale="${_stale}${_stale:+, }$_df"
          fi
        fi
      done
      if [ -n "$_stale" ]; then
        printf '\n[Engine System] Contract dist is stale: %s\n' "$_stale" >&2
        printf 'dist != compile(src). Run "bash contract/compile.sh" and stage the result.\n\n' >&2
        exit 1
      fi
    else
      printf '\n[Engine System] WARN: contract/compile.sh failed; dist-stale check skipped.\n\n' >&2
    fi
    rm -rf "$_tmpcompile"
  fi
fi

exit 0
