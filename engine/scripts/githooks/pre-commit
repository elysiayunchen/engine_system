#!/usr/bin/env bash
# Re-exec under bash when invoked via sh (parse_ac_declarations uses bash regex).
if [ -z "${BASH_VERSION:-}" ] && command -v bash >/dev/null 2>&1; then
  exec bash "$0" "$@"
fi
# Engine System - agent-neutral commit gate.
# 1. Enforce task WRITE-SET/FORBIDDEN for every staged project path, including engine files.
#    v6.12.0 (D-035): union gating across ALL active cards - a path passes when at
#    least one governing card lists it in WRITE-SET and not in that card's FORBIDDEN.
# 2. Require project-memory write-back for code changes.
# 3. Require approved decisions for protected paths (per covering card).
# 4. Warn when root anchors gain unsourced rules.

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
ENGINE_DIR="$ROOT/engine"
TAB="$(printf '\t')"
if [ -f "$ENGINE_DIR/scripts/engine-task-card.sh" ]; then
  # shellcheck source=/dev/null
  . "$ENGINE_DIR/scripts/engine-task-card.sh"
fi

# v6.25.0 (T-082): failure signal write (for Stop hook failure mode extraction)
_block_signal="S6-precommit"
_block_file=""
_fe_write_signal() {
  local rc=$?
  if [ $rc -ne 0 ] && [ -d "$ENGINE_DIR/.cache" ]; then
    printf '%s
%s
' "$_block_signal" "${_block_file:-unknown}" > "$ENGINE_DIR/.cache/last-commit-block" 2>/dev/null || true
  fi
  exit $rc
}
trap _fe_write_signal EXIT


staged="$(git diff --cached --name-only -z 2>/dev/null | tr '\0' '\n')"
[ -n "$staged" ] || exit 0

# parse_ac_declarations: Extract (ac_id, verify_cmd) pairs from a task card.
# Supports 4 AC declaration formats (D-037 / v6.17.0):
#   1. Single-line:  AC: AC-N <desc> | verify: <cmd>
#   2. Section:      ### AC-N: <title> + body's first verify: line
#   3. List item:    - AC-N: <desc> | verify: <cmd>  (or next line verify:)
#   4. Table row:    | AC-N | <desc> | verify: <cmd> |
# Output: <ac_id>\t<verify_cmd> per line (verify_cmd may be empty for SKIP).
# AC id regex: AC-[A-Za-z]*[0-9]+(\.[0-9]+)* (v6.12.1 A-3).
# Separators: | verify: / |verify: / → verify: / →verify: / line-start verify:
parse_ac_declarations() {
  if declare -F task_card_parse_ac_declarations >/dev/null 2>&1; then
    task_card_parse_ac_declarations "$@"
    return 0
  fi
  local file="$1"
  local line ac_id verify_cmd verify_rest
  local section_ac="" pending_ac=""
  while IFS= read -r line || [ -n "$line" ]; do
    # Format 2: section heading "### AC-N: <title>"
    if [[ "$line" =~ ^###[[:space:]]+(AC-[A-Za-z]*[0-9]+(\.[0-9]+)*) ]]; then
      section_ac="${BASH_REMATCH[1]}"
      pending_ac=""
      continue
    fi
    # Any other ### heading ends the current section
    if [[ "$line" =~ ^### ]]; then section_ac=""; fi
    # In section: look for first verify: line
    if [ -n "$section_ac" ]; then
      if [[ "$line" =~ ^[[:space:]]*verify:[[:space:]]*(.+) ]]; then
        verify_cmd="${BASH_REMATCH[1]}"
        verify_cmd="${verify_cmd%"${verify_cmd##*[![:space:]]}"}"
        printf '%s\t%s\n' "$section_ac" "$verify_cmd"
        section_ac=""
        continue
      fi
      continue
    fi
    # Format 1: "AC: AC-N <desc> | verify: <cmd>"
    if [[ "$line" =~ ^AC:[[:space:]]*(AC-[A-Za-z]*[0-9]+(\.[0-9]+)*) ]]; then
      ac_id="${BASH_REMATCH[1]}"
      verify_cmd=""
      case "$line" in
        *"| verify:"*)  verify_rest="${line#*"| verify:"}" ;;
        *"|verify:"*)   verify_rest="${line#*"|verify:"}" ;;
        *"→ verify:"*)  verify_rest="${line#*"→ verify:"}" ;;
        *"→verify:"*)   verify_rest="${line#*"→verify:"}" ;;
        *)              verify_rest="" ;;
      esac
      verify_cmd="${verify_rest#"${verify_rest%%[![:space:]]*}"}"
      verify_cmd="${verify_cmd%"${verify_cmd##*[![:space:]]}"}"
      printf '%s\t%s\n' "$ac_id" "$verify_cmd"
      pending_ac=""
      continue
    fi
    # Format 3: "- AC-N: <desc>" with same-line or next-line verify:
    if [[ "$line" =~ ^-[[:space:]]+(AC-[A-Za-z]*[0-9]+(\.[0-9]+)*) ]]; then
      ac_id="${BASH_REMATCH[1]}"
      verify_cmd=""
      case "$line" in
        *"| verify:"*)  verify_rest="${line#*"| verify:"}" ;;
        *"|verify:"*)   verify_rest="${line#*"|verify:"}" ;;
        *)              verify_rest="" ;;
      esac
      verify_cmd="${verify_rest#"${verify_rest%%[![:space:]]*}"}"
      verify_cmd="${verify_cmd%"${verify_cmd##*[![:space:]]}"}"
      if [ -n "$verify_cmd" ]; then
        printf '%s\t%s\n' "$ac_id" "$verify_cmd"
      else
        pending_ac="$ac_id"
      fi
      continue
    fi
    # Pending Format 3: next line "  verify: <cmd>"
    if [ -n "$pending_ac" ]; then
      if [[ "$line" =~ ^[[:space:]]*verify:[[:space:]]*(.+) ]]; then
        verify_cmd="${BASH_REMATCH[1]}"
        verify_cmd="${verify_cmd%"${verify_cmd##*[![:space:]]}"}"
        printf '%s\t%s\n' "$pending_ac" "$verify_cmd"
        pending_ac=""
        continue
      fi
      printf '%s\t\n' "$pending_ac"
      pending_ac=""
    fi
    # Format 4: "| AC-N | <desc> | verify: <cmd> |"
    if [[ "$line" =~ ^\|[[:space:]]*(AC-[A-Za-z]*[0-9]+(\.[0-9]+)*) ]]; then
      ac_id="${BASH_REMATCH[1]}"
      verify_cmd=""
      if [[ "$line" =~ verify:[[:space:]]*([^|]+) ]]; then
        verify_cmd="${BASH_REMATCH[1]}"
        verify_cmd="${verify_cmd#"${verify_cmd%%[![:space:]]*}"}"
        verify_cmd="${verify_cmd%"${verify_cmd##*[![:space:]]}"}"
      fi
      printf '%s\t%s\n' "$ac_id" "$verify_cmd"
      continue
    fi
  done < "$file"
  [ -n "$pending_ac" ] && printf '%s\t\n' "$pending_ac"
  [ -n "$section_ac" ] && printf '%s\t\n' "$section_ac"
  return 0
}

# Evidence compatibility: current records use status=pass; pre-v6.13 records
# used verdict=PASS. Accept both so historical done cards remain committable.
evidence_has_pass() {
  local content="${1:-}"
  printf '%s\n' "$content" | grep -Eiq '"status"[[:space:]]*:[[:space:]]*"pass"' && return 0
  printf '%s\n' "$content" | grep -Eiq '"status"[[:space:]]*:' && return 1
  printf '%s\n' "$content" | grep -Eiq '"verdict"[[:space:]]*:[[:space:]]*"pass"'
}

is_strict_task_project() {
  _version=""
  for _marker in "$ROOT/AGENTS.md" "$ENGINE_DIR/SYSTEM.md" "$ENGINE_DIR/ENGINE_DOCTOR.md"; do
    [ -f "$_marker" ] || continue
    _version="$(sed -n 's/.*contract-version:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' "$_marker" 2>/dev/null | head -1)"
    [ -n "$_version" ] && break
  done
  [ -n "$_version" ] || return 1
  _major="${_version%%.*}"
  _minor="${_version#*.}"; _minor="${_minor%%.*}"
  case "$_major:$_minor" in *[!0-9:]*|:*) return 1 ;; esac
  [ "$_major" -gt 6 ] 2>/dev/null || { [ "$_major" -eq 6 ] 2>/dev/null && [ "$_minor" -ge 5 ] 2>/dev/null; }
}

is_task_bootstrap_path() {
  case "$1" in engine/tasks/T-*.md|engine/decisions/D-*.md) return 0 ;; *) return 1 ;; esac
}

# v6.13.0 (T-052/D-036, issue #17): .engineignore bypass for non-product paths.
# Reads $ROOT/.engineignore (gitignore-style globs), strips comments/empty lines,
# strips trailing /** (so bare dir matches via match_any_glob's $p|$p/*), converts
# to CSV. Reuses match_any_glob — pure shell, zero subprocess spawns per file.
# Bypass scope: only 179-192 (no-card block) and 194-213 (union WRITE-SET).
# Does NOT bypass FORBIDDEN (union_not_all_forbidden), protected-path, or dist-stale.
engineignore_csv=""
if [ -f "$ROOT/.engineignore" ]; then
  engineignore_csv="$(grep -vE '^[[:space:]]*(#|$)' "$ROOT/.engineignore" 2>/dev/null | \
    sed 's|/\*\*[[:space:]]*$||' | tr '\n' ',' | sed 's/,$//')"
fi
is_engineignored() {
  [ -n "$engineignore_csv" ] || return 1
  match_any_glob "$1" "$engineignore_csv"
}

strict_task_mode=0
is_strict_task_project && strict_task_mode=1

# v6.24.0 (T-077): --no-verify seal. If bypass-detected flag exists, block ALL
# commits until resolved (approved decision + engine gate evidence).
# Config: engine/gate/config.json → seal.override_authored=true disables.
if [ "$strict_task_mode" -eq 1 ] && [ -f "$ENGINE_DIR/.cache/bypass-detected" ]; then
  _seal_override=false
  if [ -f "$ENGINE_DIR/gate/config.json" ]; then
    grep -q '"override_authored"[[:space:]]*:[[:space:]]*true' "$ENGINE_DIR/gate/config.json" 2>/dev/null && _seal_override=true
  fi
  if [ "$_seal_override" = "false" ]; then
    _bypass_info="$(cat "$ENGINE_DIR/.cache/bypass-detected" 2>/dev/null || echo unknown)"
    printf '\n[Engine System] Commit seal: --no-verify bypass detected (%s).\n' "$_bypass_info" >&2
    printf 'All commits blocked until resolved:\n' >&2
    printf '  1. Create an approved decision card covering the bypass\n' >&2
    printf '  2. Run "engine gate <task>" and stage the evidence\n' >&2
    printf '  3. Delete engine/.cache/bypass-detected\n\n' >&2
    exit 1
  fi
fi

parse_task_patterns() {
  if declare -F task_card_parse_patterns >/dev/null 2>&1; then
    task_card_parse_patterns "$1" "$2" | paste -sd, -
    return 0
  fi
  _field="$1"; _file="$2"
  _inline="$(grep "^${_field}:" "$_file" 2>/dev/null | head -1 | sed "s/^${_field}:[[:space:]]*//;s/\r$//")"
  if [ -n "$_inline" ]; then
    printf '%s' "$_inline"
    return 0
  fi
  awk -v field="$_field" '
    BEGIN { in_section=0; in_frontmatter_block=0; in_frontmatter_field=0; out=""; field_lc=tolower(field) }
    {
      sub(/\r$/, "")
      # YAML frontmatter block boundary (--- open/close)
      if ($0 ~ /^---[[:space:]]*$/) {
        in_frontmatter_block = !in_frontmatter_block
        in_frontmatter_field = 0
        next
      }
      line_lc = tolower($0)
      # markdown section header (## field, case-insensitive)
      if (line_lc ~ "^##[[:space:]]+" field_lc "[[:space:]]*$") { in_section=1; in_frontmatter_field=0; next }
      if (in_section && $0 ~ "^##[[:space:]]+") { exit }
      # YAML frontmatter field header (field:, case-insensitive, only inside frontmatter_block)
      if (in_frontmatter_block && line_lc ~ "^" field_lc ":$") {
        in_frontmatter_field=1; in_section=0; next
      }
      # frontmatter field exit: non-indented non-empty line
      if (in_frontmatter_field && $0 !~ /^[[:space:]]/ && $0 != "") { in_frontmatter_field=0 }
      # collect frontmatter field list items (indented - entries)
      if (in_frontmatter_field && $0 ~ /^[[:space:]]+-[[:space:]]+/) {
        sub(/^[[:space:]]+-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
        next
      }
      # collect markdown section list items (original logic)
      if (in_section && $0 ~ "^-[[:space:]]+") {
        sub(/^-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
      }
    }
    END { print out }
  ' "$_file" 2>/dev/null
}

match_any_glob() {
  _path="$1"; _pats="$2"; _old="$IFS"
  set -f
  IFS=','
  for _p in $_pats; do
    # Trim via parameter expansion - no subshells. A sed pipe here costs two
    # process spawns per glob token, which on Windows turns a large commit
    # (many staged files x many WRITE-SET entries) into minutes of hang.
    _p="${_p#"${_p%%[![:space:]]*}"}"
    _p="${_p%"${_p##*[![:space:]]}"}"
    [ -n "$_p" ] || continue
    # v6.12.1 (issue #11 B-3): a bare directory entry also matches its children.
    case "$_path" in $_p|$_p/*) IFS="$_old"; set +f; return 0 ;; esac
  done
  IFS="$_old"
  set +f
  return 1
}

# v6.12.0 (D-035) RC-1 fix: every active card governs, plus every staged card
# being closed (status done in the index). The old single-card pick (lex-first
# active) judged other sessions' files against the wrong card. (P037 heritage,
# T-044/D-032: done cards on disk stay cold and never govern.)
governing_files=""
for _f in "$ENGINE_DIR"/tasks/T-*.md; do
  [ -f "$_f" ] || continue
  case "$_f" in *.spec.md) continue ;; esac
  # v6.12.1 (issue #11 C-1): anchored - unanchored matching pinned done cards
  # whose PROSE merely quoted the pattern, locking the repo.
  grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*active' "$_f" 2>/dev/null || continue
  governing_files="${governing_files}${governing_files:+
}$_f"
done
closing_paths="$(printf '%s\n' "$staged" | grep -E '^engine/tasks/T-[0-9]+\.md$' | while IFS= read -r _task_path; do
  # index 中 staged 卡 status: done
  if ! git -C "$ROOT" show ":$_task_path" 2>/dev/null | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done'; then
    continue
  fi
  # v6.17.4 (T-065, issue #21): HEAD 已 done 的卡是"修改已 done 卡",不是 closing,
  # 不应加入 governing。与 issue #18 AC PASS 检查(L375-381)的修复模式一致。
  if git -C "$ROOT" show "HEAD:$_task_path" 2>/dev/null | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done'; then
    continue
  fi
  printf '%s\n' "$ROOT/$_task_path"
done)"
if [ -n "$closing_paths" ]; then
  governing_files="${governing_files}${governing_files:+
}$closing_paths"
fi

# Pre-parse each governing card once: <file>TAB<id>TAB<write-set>TAB<forbidden>
card_meta=""
card_id_list=""
old_ifs="$IFS"; IFS='
'
for _f in $governing_files; do
  [ -n "$_f" ] || continue
  IFS="$old_ifs"
  _id="$(basename "$_f" .md)"
  _ws="$(parse_task_patterns WRITE-SET "$_f")"
  _fb="$(parse_task_patterns FORBIDDEN "$_f")"
  card_meta="${card_meta}${card_meta:+
}${_f}${TAB}${_id}${TAB}${_ws}${TAB}${_fb}"
  card_id_list="${card_id_list:+$card_id_list, }$_id"
  IFS='
'
done
IFS="$old_ifs"

# Union check: pass when at least one card's WRITE-SET covers the path and that
# same card's FORBIDDEN does not. One card's FORBIDDEN never vetoes another card.
union_allows() {
  _upath="$1"
  [ -n "$card_meta" ] || return 1
  while IFS="$TAB" read -r _cf _cid _cws _cfb; do
    [ -n "$_cid" ] || continue
    [ -n "$_cws" ] || continue
    if [ -n "$_cfb" ] && match_any_glob "$_upath" "$_cfb"; then continue; fi
    if match_any_glob "$_upath" "$_cws"; then return 0; fi
  done <<UNION_EOF
$card_meta
UNION_EOF
  return 1
}

# v6.13.0 (T-052/D-036): .engineignore paths skip WRITE-SET but not FORBIDDEN.
# Returns 0 iff at least one card does NOT forbid the path (i.e., not ALL forbid).
# This is the bypass-aware companion to union_allows: when a path is engineignored,
# we don't require it in any WRITE-SET, but we still honor unanimous FORBIDDEN.
union_not_all_forbidden() {
  _naf_path="$1"
  [ -n "$card_meta" ] || return 0
  while IFS="$TAB" read -r _cf _cid _cws _cfb; do
    [ -n "$_cid" ] || continue
    if [ -z "$_cfb" ]; then return 0; fi
    match_any_glob "$_naf_path" "$_cfb" || return 0
  done <<NAF_EOF
$card_meta
NAF_EOF
  return 1
}

# Print the decision id of the first card covering the path (for protected paths).
covering_decision() {
  _dpath="$1"
  [ -n "$card_meta" ] || return 1
  while IFS="$TAB" read -r _cf _cid _cws _cfb; do
    [ -n "$_cid" ] || continue
    [ -n "$_cws" ] || continue
    if [ -n "$_cfb" ] && match_any_glob "$_dpath" "$_cfb"; then continue; fi
    if match_any_glob "$_dpath" "$_cws"; then
      _decision="$(grep 'decision:' "$_cf" 2>/dev/null | head -1 | sed 's/.*decision:[[:space:]]*//' | sed 's/[[:space:]|].*//')"
      # Union gating may have several active cards covering one path. A card
      # with decision:none must not shadow a later covering card with an
      # approved decision; keep searching for an actionable authorization.
      if [ -n "$_decision" ] && [ "$_decision" != "none" ]; then
        printf '%s' "$_decision"
        return 0
      fi
    fi
  done <<COVER_EOF
$card_meta
COVER_EOF
  return 1
}

if [ -z "$card_meta" ] && [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    is_task_bootstrap_path "$file" && continue
    is_engineignored "$file" && continue
    printf '\n[Engine System] No active task card governs %s; commit blocked.\n' "$file" >&2
    printf 'Create or activate engine/tasks/T-NNN.md before staging ordinary project changes.\n\n' >&2
    IFS="$old_ifs"
    exit 1
  done
  IFS="$old_ifs"
fi

if [ -n "$card_meta" ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    # Bootstrap channel (D-035): task/decision card files commit freely; the
    # protected-path check below still applies its own per-card rules.
    is_task_bootstrap_path "$file" && continue
    # Workstream shards are the sanctioned worker write channel.
    case "$file" in engine/workstreams/*/*/*) continue ;; esac
    # v6.13.0 (T-052): .engineignore paths skip WRITE-SET but not FORBIDDEN.
    if is_engineignored "$file"; then
      if ! union_not_all_forbidden "$file"; then
        printf '\n[Engine System] %s is engineignored but FORBIDDEN by every governing card (%s); commit blocked.\n' "$file" "$card_id_list" >&2
        printf 'Remove the path from .engineignore or from the FORBIDDEN lists of your card(s).\n\n' >&2
        IFS="$old_ifs"
        exit 1
      fi
    elif ! union_allows "$file"; then
      printf '\n[Engine System] %s is outside the WRITE-SET of every governing card (%s); commit blocked.\n' "$file" "$card_id_list" >&2
      printf 'Add the path to YOUR card WRITE-SET (outside its FORBIDDEN), or split the commit per card.\n\n' >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

# In v6.5+ a task cannot cross active -> done on declaration alone. Every AC in
# the staged card must have a staged/committed PASS evidence record, unless the
# card carries an architect-approved exempt marker.
# v6.14.0 (T-054, issue #18): only check AC PASS when the card is TRANSITIONING
# into done (HEAD status != done). Already-done cards being modified (verify
# command fixes, content updates) skip this check — historical AC content drift
# is expected and should not block bookkeeping commits. HEAD missing (new card)
# is treated as a transition (not done in HEAD -> check AC PASS).
if [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for task_path in $staged; do
    case "$task_path" in engine/tasks/T-*.md) ;; *) continue ;; esac
    task_snapshot="$(git -C "$ROOT" show ":$task_path" 2>/dev/null || true)"
    printf '%s\n' "$task_snapshot" | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done' || continue
    printf '%s\n' "$task_snapshot" | grep -qi 'exempt' && continue
    # v6.14.0 (T-054, issue #18): skip AC PASS check if HEAD already has this
    # card as done. This is a done-card modification, not an active->done
    # transition. Content drift in historical ACs is expected.
    head_task_snapshot="$(git -C "$ROOT" show "HEAD:$task_path" 2>/dev/null || true)"
    if printf '%s\n' "$head_task_snapshot" | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done'; then
      continue
    fi
    done_task_id="$(basename "$task_path" .md)"
    _tmp_ac="$(mktemp)"
    printf '%s\n' "$task_snapshot" > "$_tmp_ac"
    ac_ids="$(parse_ac_declarations "$_tmp_ac" | cut -f1)"
    rm -f "$_tmp_ac"
    if [ -z "$ac_ids" ]; then
      printf '\n[Engine System] %s is staged as done but declares no AC evidence targets.\n\n' "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    for ac_id in $ac_ids; do
      evidence_path="engine/evidence/$done_task_id/$ac_id.json"
      evidence="$(git -C "$ROOT" show ":$evidence_path" 2>/dev/null || true)"
      if ! evidence_has_pass "$evidence"; then
        printf '\n[Engine System] %s cannot be marked done: %s has no PASS evidence.\n' "$done_task_id" "$ac_id" >&2
        printf "Run 'engine verify %s' and stage engine/evidence/%s/.\n\n" "$done_task_id" "$done_task_id" >&2
        IFS="$old_ifs"
        exit 1
      fi
      # v6.18.0 (D-038/T-066 AC-7): evidence provenance gate.
      # Two legal paths:
      #   (a) machine-written: write_provenance.writer="engine-verify" AND
      #       provenance.commit == current HEAD AND argv matches "engine verify <task>"
      #   (b) manual edit: evidence JSON carries "evidence-manual-edit" marker
      #       (covering decision already enforced by protected-path gate above,
      #       since engine/evidence/** is in rules.json protected_paths).
      # Any other shape = tampering, commit blocked.
      if printf '%s\n' "$evidence" | grep -q '"evidence-manual-edit"'; then
        : # legal manual edit path (b)
      else
        _head_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
        _prov_writer="$(printf '%s\n' "$evidence" | grep -oE '"writer":"[^"]*"' | head -1 | sed 's/"writer":"//;s/"//')"
        _prov_commit="$(printf '%s\n' "$evidence" | grep -oE '"commit":"[^"]*"' | head -1 | sed 's/"commit":"//;s/"//')"
        _prov_argv="$(printf '%s\n' "$evidence" | grep -oE '"argv":"[^"]*"' | head -1 | sed 's/"argv":"//;s/"//')"
        if [ "$_prov_writer" != "engine-verify" ]; then
          printf '\n[Engine System] %s/%s evidence provenance invalid: writer="%s" (expected engine-verify).\n' "$done_task_id" "$ac_id" "$_prov_writer" >&2
          printf 'Manual edits require an "evidence-manual-edit" marker AND a covering approved decision (engine/evidence/** is protected).\n\n' >&2
          IFS="$old_ifs"
          exit 1
        fi
        if [ "$_prov_commit" != "$_head_commit" ]; then
          printf '\n[Engine System] %s/%s evidence provenance stale: commit=%s HEAD=%s.\n' "$done_task_id" "$ac_id" "$_prov_commit" "$_head_commit" >&2
          printf 'Re-run "engine verify %s" against current HEAD, or mark "evidence-manual-edit" with a covering decision.\n\n' "$done_task_id" >&2
          IFS="$old_ifs"
          exit 1
        fi
        case "$_prov_argv" in
          "engine verify $done_task_id") : ;;
          *)
            printf '\n[Engine System] %s/%s evidence provenance argv mismatch: "%s".\n' "$done_task_id" "$ac_id" "$_prov_argv" >&2
            printf 'Expected argv "engine verify %s".\n\n' "$done_task_id" >&2
            IFS="$old_ifs"
            exit 1
            ;;
        esac
      fi
    done
  done
  IFS="$old_ifs"
fi

# v6.24.0 (T-077): Quality Gate Enforcement at done-transition.
# After AC evidence passes, also require GATE.json (aggregated gate registry)
# with status=pass and valid provenance (writer=engine-gate, commit=HEAD).
if [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for task_path in $staged; do
    case "$task_path" in engine/tasks/T-*.md) ;; *) continue ;; esac
    task_snapshot="$(git -C "$ROOT" show ":$task_path" 2>/dev/null || true)"
    printf '%s\n' "$task_snapshot" | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done' || continue
    printf '%s\n' "$task_snapshot" | grep -qi 'exempt' && continue
    head_task_snapshot="$(git -C "$ROOT" show "HEAD:$task_path" 2>/dev/null || true)"
    if printf '%s\n' "$head_task_snapshot" | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done'; then
      continue
    fi
    done_task_id="$(basename "$task_path" .md)"
    gate_path="engine/evidence/$done_task_id/GATE.json"
    gate_json="$(git -C "$ROOT" show ":$gate_path" 2>/dev/null || true)"
    if [ -z "$gate_json" ]; then
      printf '\n[Engine System] %s cannot be marked done: quality gates not satisfied.\n' "$done_task_id" >&2
      printf '  MISSING GATE.json — no gate evidence found.\n' >&2
      printf '  Fix: engine gate %s && git add engine/evidence/%s/GATE.json\n\n' "$done_task_id" "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    _gate_status="$(printf '%s\n' "$gate_json" | grep -oE '"status"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"status"[[:space:]]*:[[:space:]]*"//;s/"//')"
    if [ "$_gate_status" != "pass" ]; then
      printf '\n[Engine System] %s cannot be marked done: quality gates not satisfied.\n' "$done_task_id" >&2
      printf '%s\n' "$gate_json" | grep -oE '"(verify|review|review_agent|prove)"[[:space:]]*:[[:space:]]*\{[^}]*\}' | while IFS= read -r _gline; do
        _gname="$(printf '%s' "$_gline" | sed 's/.*"\(verify\|review\|review_agent\|prove\)".*/\1/')"
        _gstatus="$(printf '%s' "$_gline" | grep -oE '"status"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"status"[[:space:]]*:[[:space:]]*"//;s/"//')"
        case "$_gstatus" in
          pass|skipped|exempt) printf '  PASS %s\n' "$_gname" >&2 ;;
          *) printf '  FAIL %s: %s\n' "$_gname" "$_gstatus" >&2 ;;
        esac
      done
      printf '  Fix: engine gate %s\n\n' "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    _gate_prov_commit="$(printf '%s\n' "$gate_json" | grep -oE '"commit"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"commit"[[:space:]]*:[[:space:]]*"//;s/"//')"
    _head_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
    if [ -n "$_gate_prov_commit" ] && [ "$_gate_prov_commit" != "$_head_commit" ]; then
      printf '\n[Engine System] %s GATE.json provenance stale: commit=%s HEAD=%s.\n' "$done_task_id" "$_gate_prov_commit" "$_head_commit" >&2
      printf '  Fix: engine gate %s (re-run against current HEAD)\n\n' "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

# v6.11.1 (D-029/T-038) AC-4: B tier pre-commit backstop - with ENGINE_WORKER=1
# set, refuse staging the shared memory trio (Codex/Cursor/Aider have no
# SessionStart hook to write the .role=worker flag; the user sets the env var).
commit_role="${ENGINE_COMMIT_ROLE:-}"
if [ "${ENGINE_WORKER:-}" = "1" ] || [ "$commit_role" = "implementer-candidate" ]; then
  shared_staged="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$' | head -1)"
  if [ -n "$shared_staged" ]; then
    printf '\n[Engine System] Worker/candidate mode cannot stage shared memory: %s\n' "$shared_staged" >&2
    printf 'Stage your engine/workstreams/<task>/<sid>/ shard instead.\n\n' >&2
    exit 1
  fi
fi

# Code changes must carry shared memory or a worker shard in the same commit.
code_changed="$(printf '%s\n' "$staged" | grep -vE '^(engine/|\.engine/)' | head -1)"
memory_written="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$|^engine/workstreams/[^/]+/([^/]+/)?[^/]+/(CONTEXT|HANDOFF)\.md$' | head -1)"
if [ -n "$code_changed" ] && [ -z "$memory_written" ] && [ "$commit_role" != "implementer-candidate" ]; then
  printf '\n[Engine System] Code changed but project memory was not staged.\n' >&2
  printf 'Coordinator: update engine/CONTEXT.md or engine/HANDOFF.md.\n' >&2
  printf 'Parallel worker: stage your engine/workstreams/<task>/<agent>/ shard.\n\n' >&2
  exit 1
fi

rules_file="$ENGINE_DIR/decisions/rules.json"
if [ -f "$rules_file" ]; then
  protected="$(sed -n '/"protected_paths"/,/\]/{
    /"protected_paths"/d
    /\]/d
    s/.*"\([^"]*\)".*/\1/p
  }' "$rules_file" 2>/dev/null)"
else
  protected=""
fi

# True when engine/tasks/T-NNN is active in the worktree or staged as done.
card_owns_itself() {
  _cid="$1"
  _card="$ENGINE_DIR/tasks/$_cid.md"
  if [ -f "$_card" ] && grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*active' "$_card" 2>/dev/null; then return 0; fi
  git -C "$ROOT" show ":engine/tasks/$_cid.md" 2>/dev/null | grep -Eq '^[[:space:]]*(>[[:space:]]*)?status:[[:space:]]*done' && return 0
  return 1
}

# === Review Evidence Provenance Check (v6.20.0, T-070; v6.21.0 T-072 agent-reviewer) ===
# 独立块,在 card_owns_itself 函数定义(约 L484-490)之后,protected-path gate 之前。
# review evidence 形状与 AC evidence 不同(per-task 非 per-AC,writer 不同,argv 不同),
# 硬复用会降低可读性。独立块更清晰。
# v6.21.0: 扩展支持 AGENT-REVIEW.json (writer=agent-reviewer, 无 argv, 有 package_sha256)。
if [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    # Route: REVIEW.json (v1 engine-review) or AGENT-REVIEW.json (v2 agent-reviewer).
    # Satellite files (QUALITY.json/SECURITY.json) have no provenance block; skip.
    _is_agent_review=false
    case "$file" in
      engine/review/evidence/*/REVIEW.json) ;;
      engine/review/evidence/*/AGENT-REVIEW.json) _is_agent_review=true ;;
      *) continue ;;
    esac
    # 路径中提取 task id,只校验任务自身的 review evidence(card_owns_itself 模式)
    _base="${file#engine/review/evidence/}"
    _tid="${_base%%/*}"
    case "$_tid" in T-*) ;; *) continue ;; esac
    card_owns_itself "$_tid" || continue   # 跨任务 review evidence 由 protected-path gate 拦
    _content="$(git -C "$ROOT" show ":$file" 2>/dev/null || true)"
    # 用 grep + sed 提取(与 L420-422 风格一致,不引入 jq)
    _prov_writer="$(printf '%s\n' "$_content" | grep -oE '"writer":"[^"]*"' | head -1 | sed 's/"writer":"//;s/"//')"
    _prov_commit="$(printf '%s\n' "$_content" | grep -oE '"commit":"[^"]*"' | head -1 | sed 's/"commit":"//;s/"//')"
    _head_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"

    if [ "$_is_agent_review" = true ]; then
      # --- AGENT-REVIEW.json (v6.21.0, T-072) ---
      if [ "$_prov_writer" != "agent-reviewer" ]; then
        printf '\n[Engine System] agent review evidence %s invalid writer: %s (expected agent-reviewer)\n' "$file" "$_prov_writer" >&2
        IFS="$old_ifs"; exit 1
      fi
      if [ "$_prov_commit" != "$_head_commit" ]; then
        printf '\n[Engine System] agent review evidence %s stale: commit=%s HEAD=%s\n' "$file" "$_prov_commit" "$_head_commit" >&2
        IFS="$old_ifs"; exit 1
      fi
      # package_sha256 validation (COMPUTE normalization)
      _prov_sha="$(printf '%s\n' "$_content" | grep -oE '"package_sha256":"[^"]*"' | head -1 | sed 's/"package_sha256":"//;s/"//')"
      _pkg_file="engine/review/evidence/$_tid/review-package.md"
      if [ -n "$_prov_sha" ] && [ -f "$ROOT/$_pkg_file" ]; then
        _py_cmd=""
        if command -v python3 >/dev/null 2>&1; then _py_cmd=python3
        elif command -v python >/dev/null 2>&1; then _py_cmd=python; fi
        if [ -n "$_py_cmd" ]; then
          _actual_sha="$("$_py_cmd" -c "
import hashlib, re, sys
with open(sys.argv[1], encoding='utf-8') as f:
    content = f.read()
normalized = re.sub(r'(> package_sha256: ).*', r'\1COMPUTE', content, count=1)
print(hashlib.sha256(normalized.encode('utf-8')).hexdigest())
" "$ROOT/$_pkg_file" 2>/dev/null || echo "")"
          if [ -n "$_actual_sha" ] && [ "$_prov_sha" != "$_actual_sha" ]; then
            printf '\n[Engine System] agent review evidence %s package_sha256 mismatch (tampered or stale package)\n' "$file" >&2
            IFS="$old_ifs"; exit 1
          fi
        fi
      fi
    else
      # --- REVIEW.json (v6.20.0, T-070; v6.24.0 D-041 from-receipt) ---
      _prov_argv="$(printf '%s\n' "$_content" | grep -oE '"argv":"[^"]*"' | head -1 | sed 's/"argv":"//;s/"//')"
      case "$_prov_writer" in
        engine-review|engine-review-from-receipt) : ;;
        *) printf '\n[Engine System] review evidence %s invalid writer: %s\n' "$file" "$_prov_writer" >&2
           IFS="$old_ifs"; exit 1 ;;
      esac
      if [ "$_prov_commit" != "$_head_commit" ]; then
        printf '\n[Engine System] review evidence %s stale: commit=%s HEAD=%s\n' "$file" "$_prov_commit" "$_head_commit" >&2
        IFS="$old_ifs"; exit 1
      fi
      case "$_prov_argv" in
        "engine review $_tid") : ;;
        "engine review $_tid --from-receipt "*) : ;;
        *) printf '\n[Engine System] review evidence %s argv mismatch: %s\n' "$file" "$_prov_argv" >&2
           IFS="$old_ifs"; exit 1 ;;
      esac
    fi
  done
  IFS="$old_ifs"
fi

if [ -n "$protected" ]; then
  # protected is newline-separated; normalize to comma-separated for match_any_glob.
  protected_csv="$(printf '%s\n' "$protected" | tr '\n' ',' | sed 's/,$//')"
  # v6.12.0 (D-035) RC-5 fix: exemption is per card ("every card exempts its own
  # files"), replacing the single lex-first exempt_id (T-041) that blocked a
  # lex-later card from committing itself while another card was active.
  # Decision cards are the bootstrap channel and commit freely; tampering is
  # guarded by git history + architect review, not by a write lock.
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    match_any_glob "$file" "$protected_csv" || continue
    case "$file" in
      engine/decisions/D-*.md) continue ;;
      engine/tasks/*)
        _base="${file#engine/tasks/}"
        _tid="${_base%%/*}"
        _tid="${_tid%.spec.md}"
        _tid="${_tid%.md}"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
      engine/evidence/*)
        # v6.18.0 (D-038/T-066): task card's own evidence directory is exempt
        # from protected-path gate (same self_exempt pattern as engine/tasks/*).
        # Cross-task evidence tampering is caught by provenance gate (L408-444)
        # and drift-check, not by the protected-path decision gate.
        _base="${file#engine/evidence/}"
        _tid="${_base%%/*}"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
      engine/review/evidence/*)
        # v6.20.0 (T-070): task card's own review evidence directory is
        # exempt from protected-path gate (same self_exempt pattern as
        # engine/tasks/* and engine/evidence/*). Cross-task review evidence
        # tampering is caught by provenance gate above.
        _base="${file#engine/review/evidence/}"
        _tid="${_base%%/*}"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
      engine/archive/tasks/*-progress.md)
        _tid="$(basename "$file" | sed 's/-progress\.md$//')"
        case "$_tid" in
          T-*) card_owns_itself "$_tid" && continue ;;
        esac
        ;;
    esac
    task_decision="$(covering_decision "$file" || true)"
    if [ -z "$task_decision" ] || [ "$task_decision" = "none" ]; then
      violation="$file (no covering card with a decision)"
    elif [ ! -f "$ENGINE_DIR/decisions/$task_decision.md" ]; then
      violation="$file (decision $task_decision missing)"
    elif ! grep -q 'status.*approved' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null; then
      violation="$file (decision $task_decision not approved)"
    else
      scope_line="$(grep 'scope' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null | head -1)"
      scope_raw="$(printf '%s' "$scope_line" | sed 's/.*scope[[:space:]]*[:|][[:space:]]*//' | sed 's/[[:space:]]*|.*//' | tr -d '\r')"
      if ! match_any_glob "$file" "$scope_raw"; then
        violation="$file (decision $task_decision scope does not cover it)"
      else
        violation=""
      fi
    fi
    if [ -n "$violation" ]; then
      printf '\n[Engine System] Protected path blocked: %s\n\n' "$violation" >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

for anchor in AGENTS.md CLAUDE.md; do
  printf '%s\n' "$staged" | grep -qx "$anchor" || continue
  suspect="$(git diff --cached -- "$anchor" 2>/dev/null | grep '^+' | grep -v '^+++' | grep -iE '(MUST|NEVER|ALWAYS)' | grep -vi 'source:' | wc -l | tr -d ' ')"
  if [ "$suspect" -gt 0 ]; then
    printf '\n[Engine System] Anchor warning: %s adds %s MUST/NEVER/ALWAYS line(s) without source:.\n\n' "$anchor" "$suspect" >&2
  fi
done

# T-051 (v6.12.3): dist-stale gate - if contract source or dist files are staged,
# verify working-tree dist == compile(src). Catches:
# (a) direct dist edits without source update
# (b) source changes without running bash contract/compile.sh
if [ -f "$ROOT/contract/compile.sh" ]; then
  _contract_touch="$(printf '%s\n' "$staged" | grep -E '^contract/src/|^(ENGINE_FILE_SYSTEM_v5\.md|runtime-law\.md|rules\.json|plugin/\.claude/commands/engine-init\.md|engine/prompts/init\.md|plugin/engine/prompts/init\.md)$' | head -1)"
  if [ -n "$_contract_touch" ]; then
    _tmpcompile="$(mktemp -d 2>/dev/null || mktemp -d -t engcompile)"
    if ENGINE_COMPILE_OUT="$_tmpcompile" bash "$ROOT/contract/compile.sh" >/dev/null 2>&1; then
      _stale=""
      for _df in \
        ENGINE_FILE_SYSTEM_v5.md \
        runtime-law.md \
        rules.json \
        plugin/.claude/commands/engine-init.md \
        engine/prompts/init.md \
        plugin/engine/prompts/init.md
      do
        if [ -f "$_tmpcompile/$_df" ] && [ -f "$ROOT/$_df" ]; then
          if ! diff -q "$_tmpcompile/$_df" "$ROOT/$_df" >/dev/null 2>&1; then
            _stale="${_stale}${_stale:+, }$_df"
          fi
        fi
      done
      if [ -n "$_stale" ]; then
        printf '\n[Engine System] Contract dist is stale: %s\n' "$_stale" >&2
        printf 'dist != compile(src). Run "bash contract/compile.sh" and stage the result.\n\n' >&2
        exit 1
      fi
    else
      printf '\n[Engine System] WARN: contract/compile.sh failed; dist-stale check skipped.\n\n' >&2
    fi
    rm -rf "$_tmpcompile"
  fi
fi

exit 0
