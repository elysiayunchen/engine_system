{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_engine_system": "自维护循环 hooks 配置。由 install.sh / install.ps1 自动铺设。如果目标项目已有 .claude/settings.json，安装器不覆盖此文件；运行 /engine-sync 合并 hooks 字段。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash engine/scripts/engine-hook-session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash engine/scripts/engine-hook-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
