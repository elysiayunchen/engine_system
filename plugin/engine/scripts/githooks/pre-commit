#!/bin/sh
# Engine System - agent-neutral commit gate.
# 1. Enforce task WRITE-SET/FORBIDDEN for every staged project path, including engine files.
# 2. Require project-memory write-back for code changes.
# 3. Require approved decisions for protected paths.
# 4. Warn when root anchors gain unsourced rules.

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
ENGINE_DIR="$ROOT/engine"

staged="$(git diff --cached --name-only -z 2>/dev/null | tr '\0' '\n')"
[ -n "$staged" ] || exit 0

is_strict_task_project() {
  _version=""
  for _marker in "$ROOT/AGENTS.md" "$ENGINE_DIR/SYSTEM.md" "$ENGINE_DIR/ENGINE_DOCTOR.md"; do
    [ -f "$_marker" ] || continue
    _version="$(sed -n 's/.*contract-version:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' "$_marker" 2>/dev/null | head -1)"
    [ -n "$_version" ] && break
  done
  [ -n "$_version" ] || return 1
  _major="${_version%%.*}"
  _minor="${_version#*.}"; _minor="${_minor%%.*}"
  case "$_major:$_minor" in *[!0-9:]*|:*) return 1 ;; esac
  [ "$_major" -gt 6 ] 2>/dev/null || { [ "$_major" -eq 6 ] 2>/dev/null && [ "$_minor" -ge 5 ] 2>/dev/null; }
}

is_task_bootstrap_path() {
  case "$1" in engine/tasks/T-*.md|engine/decisions/D-*.md) return 0 ;; *) return 1 ;; esac
}

strict_task_mode=0
is_strict_task_project && strict_task_mode=1

parse_task_patterns() {
  _field="$1"; _file="$2"
  _inline="$(grep "^${_field}:" "$_file" 2>/dev/null | head -1 | sed "s/^${_field}:[[:space:]]*//;s/\r$//")"
  if [ -n "$_inline" ]; then
    printf '%s' "$_inline"
    return 0
  fi
  awk -v field="$_field" '
    BEGIN { in_section=0; in_frontmatter_block=0; in_frontmatter_field=0; out=""; field_lc=tolower(field) }
    {
      sub(/\r$/, "")
      # YAML frontmatter block boundary (--- open/close)
      if ($0 ~ /^---[[:space:]]*$/) {
        in_frontmatter_block = !in_frontmatter_block
        in_frontmatter_field = 0
        next
      }
      line_lc = tolower($0)
      # markdown section header (## field, case-insensitive)
      if (line_lc ~ "^##[[:space:]]+" field_lc "[[:space:]]*$") { in_section=1; in_frontmatter_field=0; next }
      if (in_section && $0 ~ "^##[[:space:]]+") { exit }
      # YAML frontmatter field header (field:, case-insensitive, only inside frontmatter_block)
      if (in_frontmatter_block && line_lc ~ "^" field_lc ":$") {
        in_frontmatter_field=1; in_section=0; next
      }
      # frontmatter field exit: non-indented non-empty line
      if (in_frontmatter_field && $0 !~ /^[[:space:]]/ && $0 != "") { in_frontmatter_field=0 }
      # collect frontmatter field list items (indented - entries)
      if (in_frontmatter_field && $0 ~ /^[[:space:]]+-[[:space:]]+/) {
        sub(/^[[:space:]]+-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
        next
      }
      # collect markdown section list items (original logic)
      if (in_section && $0 ~ "^-[[:space:]]+") {
        sub(/^-[[:space:]]+/, "")
        sub(/[[:space:]]+\(.*/, "")
        if ($0 != "") out = (out == "" ? $0 : out "," $0)
      }
    }
    END { print out }
  ' "$_file" 2>/dev/null
}

match_any_glob() {
  _path="$1"; _pats="$2"; _old="$IFS"
  set -f
  IFS=','
  for _p in $_pats; do
    _p="$(printf '%s' "$_p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -n "$_p" ] || continue
    case "$_path" in $_p) IFS="$_old"; set +f; return 0 ;; esac
  done
  IFS="$_old"
  set +f
  return 1
}

# Prefer the active card. A staged card being closed remains the governing
# boundary. Only legacy (<6.5/no marker) projects fall back to an unrelated
# historical done card.
task_file=""
for f in "$ENGINE_DIR"/tasks/T-*.md; do
  [ -f "$f" ] || continue
  if grep -q 'status:.*active' "$f" 2>/dev/null; then task_file="$f"; break; fi
done
if [ -z "$task_file" ]; then
  closing_task_path="$(printf '%s\n' "$staged" | grep -E '^engine/tasks/T-[0-9]+\.md$' | sort -r | while IFS= read -r _task_path; do
    if git -C "$ROOT" show ":$_task_path" 2>/dev/null | grep -q 'status:.*done'; then
      printf '%s\n' "$_task_path"
      break
    fi
  done)"
  [ -n "$closing_task_path" ] && task_file="$ROOT/$closing_task_path"
fi
if [ -z "$task_file" ] && [ "$strict_task_mode" -eq 0 ]; then
  for f in $(ls -1 "$ENGINE_DIR"/tasks/T-*.md 2>/dev/null | sort -r); do
    [ -f "$f" ] || continue
    if grep -q 'status:.*done' "$f" 2>/dev/null; then task_file="$f"; break; fi
  done
fi

if [ -z "$task_file" ] && [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    is_task_bootstrap_path "$file" && continue
    printf '\n[Engine System] No active task card governs %s; commit blocked.\n' "$file" >&2
    printf 'Create or activate engine/tasks/T-NNN.md before staging ordinary project changes.\n\n' >&2
    IFS="$old_ifs"
    exit 1
  done
  IFS="$old_ifs"
fi

if [ -n "$task_file" ]; then
  task_id="$(basename "$task_file" .md)"
  write_set="$(parse_task_patterns WRITE-SET "$task_file")"
  forbidden="$(parse_task_patterns FORBIDDEN "$task_file")"
  if [ -z "$write_set" ]; then
    printf '\n[Engine System] %s has no readable WRITE-SET; commit blocked.\n\n' "$task_id" >&2
    exit 1
  fi
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    case "$file" in engine/.cache/*|.engine/*) continue ;; esac
    if [ -n "$forbidden" ] && match_any_glob "$file" "$forbidden"; then
      printf '\n[Engine System] %s is FORBIDDEN by %s; commit blocked.\n\n' "$file" "$task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    if ! match_any_glob "$file" "$write_set"; then
      printf '\n[Engine System] %s is outside %s WRITE-SET; commit blocked.\nWRITE-SET: %s\n\n' "$file" "$task_id" "$write_set" >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

# In v6.5+ a task cannot cross active -> done on declaration alone. Every AC in
# the staged card must have a staged/committed PASS evidence record, unless the
# card carries an architect-approved exempt marker.
if [ "$strict_task_mode" -eq 1 ]; then
  old_ifs="$IFS"; IFS='
'
  for task_path in $staged; do
    case "$task_path" in engine/tasks/T-*.md) ;; *) continue ;; esac
    task_snapshot="$(git -C "$ROOT" show ":$task_path" 2>/dev/null || true)"
    printf '%s\n' "$task_snapshot" | grep -q 'status:.*done' || continue
    printf '%s\n' "$task_snapshot" | grep -qi 'exempt' && continue
    done_task_id="$(basename "$task_path" .md)"
    ac_ids="$(printf '%s\n' "$task_snapshot" | sed -n 's/^AC:[[:space:]]*\(AC-[0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/p')"
    if [ -z "$ac_ids" ]; then
      printf '\n[Engine System] %s is staged as done but declares no AC evidence targets.\n\n' "$done_task_id" >&2
      IFS="$old_ifs"
      exit 1
    fi
    for ac_id in $ac_ids; do
      evidence_path="engine/evidence/$done_task_id/$ac_id.json"
      evidence="$(git -C "$ROOT" show ":$evidence_path" 2>/dev/null || true)"
      if ! printf '%s\n' "$evidence" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"pass"'; then
        printf '\n[Engine System] %s cannot be marked done: %s has no PASS evidence.\n' "$done_task_id" "$ac_id" >&2
        printf "Run 'engine verify %s' and stage engine/evidence/%s/.\n\n" "$done_task_id" "$done_task_id" >&2
        IFS="$old_ifs"
        exit 1
      fi
    done
  done
  IFS="$old_ifs"
fi

# v6.11.1 (D-029/T-038) AC-4: B 档 pre-commit 兜底——ENGINE_WORKER=1 时拒绝共享三件套 staged
# B 档适配器(Codex/Cursor/Aider)无 SessionStart hook 自动写 .role=worker 标志,
# 用户显式设 ENGINE_WORKER=1 环境变量后,pre-commit 拒绝共享三件套 staged。
# 与 C 档 PreToolUse 双信号机器强制互补。
if [ "${ENGINE_WORKER:-}" = "1" ]; then
  shared_staged="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$' | head -1)"
  if [ -n "$shared_staged" ]; then
    printf '\n[Engine System] Worker mode (ENGINE_WORKER=1) cannot stage shared memory: %s\n' "$shared_staged" >&2
    printf 'Stage your engine/workstreams/<task>/<sid>/ shard instead.\n\n' >&2
    exit 1
  fi
fi

# Code changes must carry shared memory or a worker shard in the same commit.
code_changed="$(printf '%s\n' "$staged" | grep -vE '^(engine/|\.engine/)' | head -1)"
memory_written="$(printf '%s\n' "$staged" | grep -E '^engine/(CONTEXT|HANDOFF|ENGINE_MAP)\.md$|^engine/workstreams/[^/]+/[^/]+/(CONTEXT|HANDOFF)\.md$' | head -1)"
if [ -n "$code_changed" ] && [ -z "$memory_written" ]; then
  printf '\n[Engine System] Code changed but project memory was not staged.\n' >&2
  printf 'Coordinator: update engine/CONTEXT.md or engine/HANDOFF.md.\n' >&2
  printf 'Parallel worker: stage your engine/workstreams/<task>/<agent>/ shard.\n\n' >&2
  exit 1
fi

rules_file="$ENGINE_DIR/decisions/rules.json"
if [ -f "$rules_file" ]; then
  protected="$(sed -n '/"protected_paths"/,/\]/{
    /"protected_paths"/d
    /\]/d
    s/.*"\([^"]*\)".*/\1/p
  }' "$rules_file" 2>/dev/null)"
else
  protected=""
fi

task_decision=""
if [ -n "$task_file" ]; then
  task_decision="$(grep 'decision:' "$task_file" 2>/dev/null | head -1 | sed 's/.*decision:[[:space:]]*//' | sed 's/[[:space:]|].*//')"
fi

if [ -n "$protected" ]; then
  # protected is newline-separated; normalize to comma-separated for match_any_glob.
  protected_csv="$(printf '%s\n' "$protected" | tr '\n' ',' | sed 's/,$//')"
  # T-041 (v6.11.3): active/closing 任务卡自身豁免 protected 检查。
  # protected_paths 门禁目的是防跨任务卡改动,不是阻止任务卡改自己的元数据。
  # 任务卡 T-NNN 改 .md / .spec.md / 子目录(progress 等) / 归档 progress 时豁免;
  # 其他 protected 路径(ENGINE_FILE_SYSTEM_v5.md / contract/src/** / plugin/manifest.json 等)
  # 仍需 decision scope 覆盖。修复 T-039/T-040 撞的门禁死循环。
  exempt_id=""
  if [ -n "$task_file" ]; then
    exempt_id="$(basename "$task_file" .md)"
  fi
  old_ifs="$IFS"; IFS='
'
  for file in $staged; do
    [ -n "$file" ] || continue
    match_any_glob "$file" "$protected_csv" || continue
    # T-041: 任务卡 T-NNN 自身及其衍生文件豁免 protected 检查
    if [ -n "$exempt_id" ]; then
      case "$file" in
        engine/tasks/$exempt_id.md|engine/tasks/$exempt_id.spec.md|engine/tasks/$exempt_id/*|engine/archive/tasks/$exempt_id-progress.md)
          continue ;;
      esac
    fi
    if [ -z "$task_decision" ]; then
      violation="$file (no task decision)"
    elif [ ! -f "$ENGINE_DIR/decisions/$task_decision.md" ]; then
      violation="$file (decision $task_decision missing)"
    elif ! grep -q 'status.*approved' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null; then
      violation="$file (decision $task_decision not approved)"
    else
      scope_line="$(grep 'scope' "$ENGINE_DIR/decisions/$task_decision.md" 2>/dev/null | head -1)"
      scope_raw="$(printf '%s' "$scope_line" | sed 's/.*scope[[:space:]]*[:|][[:space:]]*//' | sed 's/[[:space:]]*|.*//' | tr -d '\r')"
      if ! match_any_glob "$file" "$scope_raw"; then
        violation="$file (decision $task_decision scope does not cover it)"
      else
        violation=""
      fi
    fi
    if [ -n "$violation" ]; then
      printf '\n[Engine System] Protected path blocked: %s\n\n' "$violation" >&2
      IFS="$old_ifs"
      exit 1
    fi
  done
  IFS="$old_ifs"
fi

for anchor in AGENTS.md CLAUDE.md; do
  printf '%s\n' "$staged" | grep -qx "$anchor" || continue
  suspect="$(git diff --cached -- "$anchor" 2>/dev/null | grep '^+' | grep -v '^+++' | grep -iE '(MUST|NEVER|ALWAYS)' | grep -vi 'source:' | wc -l | tr -d ' ')"
  if [ "$suspect" -gt 0 ]; then
    printf '\n[Engine System] Anchor warning: %s adds %s MUST/NEVER/ALWAYS line(s) without source:.\n\n' "$anchor" "$suspect" >&2
  fi
done

exit 0
